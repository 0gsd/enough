{
  "_doc": [
    "UI configuration for enough.",
    "",
    "This file ships as a TEMPLATE at <install>/defaults/ui-config.json.",
    "The first time enough runs, it is copied to ~/enough/config/ui.json",
    "where it becomes your LIVE config. Edits to the live file are",
    "preserved across upstream git pulls; edits to this template file",
    "affect only future installs.",
    "",
    "Two knobs users can change:",
    "  current.theme  \u2014 name of an entry under 'themes' below",
    "  current.font   \u2014 name of an entry under 'fonts' below",
    "  help_highlight_on_new_project \u2014 light up the (?) help",
    "    bubbles on a project's first launch until each is viewed (default true)",
    "",
    "For zoom, use your browser's native zoom (Cmd +/- on Mac, Ctrl on Win/Linux).",
    "",
    "Power users: add your own entries under 'themes' or 'fonts' by",
    "copying an existing block and renaming the key. The new entry's",
    "'label' will appear in the UI dropdown on next reload. Every color",
    "key is applied as a CSS custom property (--key), so any HTML/CSS",
    "customization you do elsewhere can reference the same palette."
  ],
  "current": {
    "theme": "enough-default",
    "font": "mono"
  },
  "help_highlight_on_new_project": true,
  "fonts": {
    "mono": {
      "label": "Monospace (SF Mono)",
      "stack": "ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace"
    },
    "sans": {
      "label": "Sans-serif",
      "stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', system-ui, sans-serif"
    },
    "serif": {
      "label": "Serif (Georgia)",
      "stack": "Georgia, 'Times New Roman', 'Hoefler Text', serif"
    },
    "mono-alt": {
      "label": "Monospace (Courier)",
      "stack": "'Courier New', Courier, 'Lucida Console', monospace"
    }
  },
  "themes": {
    "enough-default": {
