# The fabula 1: a built-in of MacroCOSM's core. What a decompile makes from one input: everything found in it or
# derived from it, enumerated item by item: its inspiration, meaning, intent, construction, production and
# assertions, and its atems. One format, three flavours: fabulan (narrative and non-fiction prose), fabulap (poetry,
# metered verse, song lyrics), fabulac (code: a folder of source). A fabula is compiled into a short (markdown for
# prose and verse; for code a cshort, a folder of source rebuilt from it, viewed and never run) and said most plainly
# as an atem (for code also a catem, everything a user can do, at one of three depths).
#
# Every emf/1 file is a valid fabulan with no conversion: the declaration reads the old spelling (declaration.old),
# and the six modules L E K P T X keep emf/1's kinds, fields and closed lists exactly. Four modules are added
# (I Inspiration, N Intent, C Construction, R Production), and P gains two kinds (reading, case). The core's
# dialectic module D (question, session) is not declared here: the reader merges it in from core.modules.cosm, as it
# does for every format (MacroCOSM OES 13.4, 18.6).
#
# A kind's flavours: note says which flavours may hold it (check flavour-kind). The dialectic: block holds the opening
# questions, one bank per flavour. The prose is MacroCOSM OES (https://macro.cosmoes.org/), section 18.4, and the
# dialectic is its section 18.6. The reference reader is enough/macrocosm.py; the fabula's own checks are
# enough/fabula.py's (listed under checks.own). Where this file and the reader disagree, the reader wins and this file
# is corrected.
#
# Written in the COSM YAML subset: no anchors, no aliases, no tags, one document. Words that YAML 1.1 reads as
# booleans (on, off, yes, no) are quoted.
#
# Copyright © 2026 Graham Smith. CC BY 4.0, with a patent promise under OWFa 1.0. See defaults/cosm/NOTICE.md.

manifest: minicosm/0
macrocosm: 0.7.0
name: fabula
title: fabula
version: 1
core: true
summary: "One input decompiled: everything found in it or derived from it, enumerated: its inspiration, meaning, intent, construction, production and assertions, and its atems. Three flavours: prose, verse, code."
spec: https://macro.cosmoes.org/      # MacroCOSM OES, section 18.4 (bundled as docs/MACROCOSM_OES.md)
reference: [enough/macrocosm.py]

declaration:
  key: oes
  value: fabula/1
  old: [emf/1]                    # earlier oes: values this manifest reads and never writes; the reader says how: old
  absent: refuse
  legacy: []
  both: oes
  unknown: refuse

format:
  extension: .cosm
  syntax: the COSM YAML subset
  forbidden: [anchors, aliases, tags, multiple documents]
  booleans: ['true', 'false']
  encoding: utf-8
  byte-order-mark: tolerated
  newlines: [lf, crlf]

volume:
  catalog: ['<text>.fabulan.cosm', '<text>.fabulap.cosm', '<folder>.fabulac.cosm', '<name>.fabulan.cosm',
            '<name>.fabulap.cosm', '<text>.cosm']      # <text>.cosm is the old twin name, read forever; a fabula is
  single-file: true                                   # identified by its declaration, never by its file name

catalog:
  keys: [oes, macrocosm, flavour, purpose, written-for, ruled-by, cases, id, name, source, derived, program, head, parts,
         atem, shorts, catems, entailed, nodes]
  purpose: [transconception]                           # absent: kept for its own sake; transconception turns on the
                                                       # checks and gates of transconception (MacroCOSM OES 18.4.9),
                                                       # written after flavour; enough/transconception.py runs them
  written-for-fields: [assumes]                        # written-for: {assumes: [text]}: what a reader is taken to know
  written-for-default: {assumes: ['how to read a program''s commands, files and messages', 'plain English']}
  ruled-by-form: 'R:maker/<slug> whose capacity is transconceiver, or none: nobody could rule, and the fabulac is kept
                  unruled and says so'
  cases-form: '<folder>.cases.json beside the fabulac: the outside cases as data, the recorder''s and runner''s shape;
               the fabulac keeps P:case items for the cases a person wrote or ruled'
  id: fabula/<slug>
  id-old: [emf/<slug>]                                 # an emf/1 twin's id, read as it is
  flavour: [fabulan, fabulap, fabulac]
  flavour-absent: fabulan                              # every emf/1 file
  source-fields: [path, sha256, size, mtime_ns]                    # a text; absent for a standalone fabula
  source-folder-fields: [path, kind, language, files, bytes, skipped, tree, commit, origin, licence, obtained, swhid]   # a folder (fabulac)
  source-obtained: [public, permitted, own]                        # how the source came to the reader
  source-swhid: '{dir: swh:1:dir:<hex>, rev: swh:1:rev:<hex>}: the folder''s and the revision''s identifiers, by rule'
  source-kind: [text, folder, authored]                            # absent: text; authored: a fabulac a person wrote
                                                                   # first, its own source (MacroCOSM OES 18.4.1, 18.4.7)
  source-authored-fields: [kind, language, licence, by, at, brief] # by: refs R:maker; brief: the brief's path beside it
  program-fields: [kind, start, serve]                             # a fabulac's program: what it specifies, how it starts
  program-kind: [tool, library, service]                           # tool: started, then it ends; library: called;
                                                                   # service: keeps running and answers on a port
  program-serve-fields: [port, reach]                              # a service's: the port (0: the host chooses) and the
                                                                   # addresses it may reach; served in a later minor
  entailed-fields: [path, at, run, files, kept]                    # an authored fabulac's last entailment (MacroCOSM OES
                                                                   # 18.4.1): path, the folder beside it (tally/)
  entailed-kept-fields: [path, decision]                           # a file changed by hand and kept: decision, the
                                                                   # N:decision that records the choice (keeping in step,
                                                                   # enough/fabulac_entail.py)
  head-form: 'oes:fabula/<database>: a part''s head fabulac, by its URI (MacroCOSM OES 18.4.7); a text field, resolved
              over the fabulacs the reader knows (enough/fabulac_head.py), not a reference'
  parts-fields: [uri, path, sha256]                                # a head's parts: the part's URI, its file's path
                                                                   # relative to the head, that file's sha256 when the
                                                                   # head last checked it (MacroCOSM OES 18.4.7)
  entailed-files-fields: [path, sha256, from, brief]               # one per file written: from, refs or rules; brief,
                                                                   # the sha256 of what it was entailed from
                                                                   # (enough/thym/moves/authored_code.py brief_digest)
  tree: 'sha256 over the read set: for each file read, sorted by the UTF-8 bytes of its relative path, the bytes of
         <relative path> NUL <lowercase hex sha256 of its bytes> LF (MacroCOSM OES 18.4.1; Thym 20.1 uses the same digest)'
  derived-fields: [at, by, model, route, provider, program, run, mode, completeness, chunks, dropped, runs]
  derived-modes: [model, rules]
  derived-routes: [local, cloud]                                   # absent in rules mode
  derived-completeness: [full, atem, outline]                      # outline: a rules-only skeleton, a fabulac's or a
                                                                   # fabulap's (scan: its lines, sounds and form)
  derived-runs-fields: [program, run, at, model, route, provider] # one per run that wrote into the fabula, a settle
                                                                   # run included; the single keys describe the last
                                                                   # run that derived the fabula from its source
  atem-fields: [line, focus, push, pull]
  shorts-fields: [path, at, by, mode, order, route, language, files, entailed, target, layout, evidence]
  shorts-entailed: [apart, beside]                                 # a cshort entailed from the fabulac alone (apart)
                                                                   # or with the source at hand (beside)
  shorts-target: a ref to N:target/<language>
  shorts-layout: 'the layout short it was entailed with: <folder>.layout-<language>-<YYYY-MM-DD-HHMM>.md'
  shorts-evidence-fields: [level, steps, against, inputs, where, at, by]   # steps: {kept, agree}; where: {file, digest}
  shorts-path: '<text-stem>.short-<YYYY-MM-DD-HHMM>.md; a cshort: <folder>.cshort-<YYYY-MM-DD-HHMM>/'
  shorts-modes: [model, rules]
  shorts-orders: [told, weight, code]                              # code: a cshort, compiled file by file
  catems-fields: [path, at, by, mode, route, depth]
  catems-path: '<folder>.catem-<YYYY-MM-DD-HHMM>.md'
  catems-depths: [line, overview, manual]

module-file:
  shapes:
    - {key: nodes, holds: 'a list of items, each a mapping with a string id'}
  duplicate-id: load error, the first wins

ids:
  item-form: '<module>:<kind>/<slug>'
  passage-atem: 'X:atem/<n>'
  code-slug: 'a file: its path respelled by the Canon rule (tally--cli-py); a Python name: its dotted name (tally.cli.main)'
  inside-own-text: bare

paths:
  form: '<module>/<kind>/<slug>#<field>'
  levels: [module, kind, item, field]
  segments:
    module: '[ILEKNCRPTX]'                # the reader adds the core's D
    kind: '[a-z][a-z0-9-]*'
    slug: '[A-Za-z0-9](?:[A-Za-z0-9._@-]*[A-Za-z0-9_@-])?'
    field: '[A-Za-z0-9][A-Za-z0-9_-]*(?:\.[A-Za-z0-9][A-Za-z0-9_-]*|\[[0-9]+\])*'
  map:
    - {path: '<module>', id: none}
    - {path: '<module>/<kind>', id: none}
    - {path: '<module>/<kind>/<slug>', id: '<module>:<kind>/<slug>'}
    - {path: '<item path>#<field>', id: none}
  qualified: 'oes:fabula/<database>/<path>; oes:emf/<database>/<path> names the same thing'
  qualified-database: the catalog id without fabula/ (or without emf/, for an old twin)
  case: kept and significant
  refused: [a leading slash, a trailing slash, an empty segment, '.', '..', percent-encoding, a backslash, whitespace, a colon,
            non-ASCII or control characters, a segment ending in a dot, a second '#', a kind the module does not declare,
            more than three segments, 'a Windows reserved name as any segment, in any case, alone or before a dot (con, con.txt, prn, aux, nul, com0-9, lpt0-9)']

envelope:
  fields: [id, type, name, summary, status, visibility, provenance, pending, links, span, salience, withheld]
  references: [links]
  required: [id, type, name, summary, provenance]
  required-in-P: [id, type, name, summary, provenance, stance]     # every claim, reading and case says how it is known
  status: [active, dormant, planned, retired]
  visibility: [public, internal, restricted]
  provenance:
    fields: [mode, sources, confidence, state, answered]
    modes: [dialectic, net-scan, system-scan, integration, structured-intake, manual, derived, asserted, archetype,
            catalogue, directory, accounting]
    states: [known, pending, not-disclosed, stale]
    state-default: known
    confidence: a number from 0 to 1
    rules-mode: '{mode: derived, confidence: 0.3, state: pending} with pending: "a model has not read this passage"'
    answered: '{<field path>: {sources: [D:session/<id>], confidence}}: the fields a dialectic answer wrote into an item
               that was made some other way'
  span: '{lines: "12-18"} or {start: "<up to 60 characters>", end: "<up to 60 characters>"}; in a fabulac
         {file: <path relative to source.path>, lines: "12-40"}'
  stance: 'on a claim, how the text knows it (emf/1, unchanged); on every other kind that carries one, how the fabula
           knows the item: observed (read in the input), deduced (reasoned from other items), assumed (taken without
           support), hearsay (someone said so: an answer, a critic, a document), opinion (a judgement, a model''s own
           reading), axiom (given)'
  withheld: 'the field paths a person declined to give (a dialectic answer declined); the item''s provenance.state is
             then not-disclosed'
  open-question: '{pending: "<the question>"}'
  sentinels: [none, self]
  unknown-fields: allowed and kept

links:
  rels: [is-a, part-of, depends-on, supports, contradicts, resolves, exemplifies, defines, mentions]

closed-lists:
  stance: [axiom, observed, deduced, opinion, assumed, hearsay]
  salience: [critical, high, normal, low]
  feed.origin: [feed, user]
  whose.by: [author, expert, critic, model, reader]                       # P:reading
  intended: [true, false]                                                 # C:behaviour, C:device, C:form, P:reading
  senses: [sight, hearing, touch, taste, smell, movement]                 # C:device: the senses an image reaches
  rules.held: [true, false]                                               # C:form: a rule of its form kept or not, or {pending: "…"}
  division: [chapter, section, paragraph, scene, list, quotation, stanza, verse, chorus, refrain, bridge, other]
  foot: [iamb, trochee, anapaest, dactyl, spondee, amphibrach, mixed, none]
  basis: [accentual-syllabic, accentual, syllabic, quantitative, free]
  ending: [stopped, run-on]
  quality: [full, slant, eye, identical]
  placement: [end, internal]
  perspective: [first, second, third, mixed]
  force: [must, should, may]
  horizon: [never, later]
  surface: [function, method, class, command, format, stream]
  scope: [standard, run-time, test, build, optional]
  set-in: [environment, file, option, constant]
  capacity: [author, maintainer, contributor, editor, translator, publisher, performer, composer, transconceiver]
  ruling.is: [kept, alike, free, kept-wrong, changed]                     # ruling is a list, one entry per target
  ruling.relied-on: [documented, tested, used, seen]                      # (made-for; none: any target)
  relied-on: [documented, tested, used, seen]
  nature: [feature, fix, refactor, removal, docs, tests, build, revision]

references:
  forms:
    - {form: bare, example: 'K:concept/compost', names: an item of the same fabula}
    - {form: typed-link, example: '{rel: contradicts, to: P:claim/x}', names: its to; rel from links.rels}
    - {form: role, example: 'roles: {actor: E:person/x, condition: "when it rains"}', names: 'an item where the value is an id; text otherwise'}
    - {form: open-question, example: '{pending: "<question>"}', names: an answer still owed}
    - {form: address, example: 'N:audience/owners#who', names: 'an item and a field of it, absent or open fields included (the reader resolves the item before #; MacroCOSM OES 9.3)'}
  unresolved: error

modules:
  I:
    name: Inspiration
    subtitle: What the work came from
    kinds:
      influence: {refs: [roles.*], checked: [stance, how], flavours: [fabulan, fabulap, fabulac],
                  required: [id, type, name, summary, provenance, stance]}
      allusion: {refs: [roles.*], checked: [stance, cue], flavours: [fabulan, fabulap],
                 required: [id, type, name, summary, provenance, stance]}
      occasion: {refs: [roles.*], checked: [stance, when], flavours: [fabulan, fabulap, fabulac],
                 required: [id, type, name, summary, provenance, stance]}
  L:
    name: Lexicon
    subtitle: The words the text leans on
    kinds:
      term: {refs: [], checked: [feed, sense], flavours: [fabulan, fabulap, fabulac]}
  E:
    name: Entities
    subtitle: The particular things and people named
    kinds:
      person: {refs: [], flavours: [fabulan, fabulap, fabulac]}
      org: {refs: [], flavours: [fabulan, fabulap, fabulac]}
      place: {refs: [], flavours: [fabulan, fabulap, fabulac]}
      work: {refs: [], flavours: [fabulan, fabulap, fabulac]}
      thing: {refs: [], flavours: [fabulan, fabulap, fabulac]}
  K:
    name: Concepts
    subtitle: The ideas and universals the text uses
    kinds:
      concept: {refs: [defined-by], flavours: [fabulan, fabulap, fabulac]}
  N:
    name: Intent
    subtitle: What the work means to do, for whom, and what it chose
    kinds:
      aim: {refs: [roles.*], checked: [stance, measure], flavours: [fabulan, fabulap, fabulac],
            required: [id, type, name, summary, provenance, stance]}
      audience: {refs: [], checked: [stance, who, needs], flavours: [fabulan, fabulap, fabulac],
                 required: [id, type, name, summary, provenance, stance]}
      use: {refs: [for, via], checked: [stance, steps, gets], flavours: [fabulac],
            required: [id, type, name, summary, provenance, stance]}
      requirement: {refs: [met-by, checked-by], checked: [stance, force, of], flavours: [fabulac],
                    required: [id, type, name, summary, provenance, stance, force],
                    closed: {of: [behaviour, quality, making]}}
      decision: {refs: [by, changed-in], checked: [stance, chose, over, because], flavours: [fabulan, fabulap, fabulac],
                 required: [id, type, name, summary, provenance, stance, chose]}
      exclusion: {refs: [], checked: [stance, horizon, because], flavours: [fabulan, fabulap, fabulac],
                  required: [id, type, name, summary, provenance, stance]}
      target: {refs: [provides.for], checked: [language, version, weighed, provides, spike, verdict, conditions, at, by, stance,
                                               edition, program, library, made],
               flavours: [fabulac], required: [id, type, name, summary, provenance, stance, language],
               closed: {weighed.score: [0, 1, 2, 3], provides.by: [built-in, library, binding, written, cannot, dropped],
                        verdict: [feasible, feasible-with, not]}}
  C:
    name: Construction
    subtitle: How the work is built
    kinds:
      part: {refs: [of], checked: [division, number, heading, stance], flavours: [fabulan, fabulap],
             required: [id, type, name, summary, provenance, stance, division]}
      device: {refs: [where], checked: [figure, effect, cue, senses, intended, stance], flavours: [fabulan, fabulap],
               required: [id, type, name, summary, provenance, stance, figure]}
      voice: {refs: [roles.*], checked: [perspective, tone, stance], flavours: [fabulan, fabulap],
              required: [id, type, name, summary, provenance, stance]}
      line: {refs: [part, metre], checked: [number, text, stresses, syllables, rhyme, ending, stance], flavours: [fabulap],
             required: [id, type, name, summary, provenance, stance, number]}
      metre: {refs: [lines, departures.line], checked: [foot, feet, basis, stance], flavours: [fabulap],
              required: [id, type, name, summary, provenance, stance]}
      rhyme: {refs: [lines], checked: [scheme, sound, quality, placement, stance], flavours: [fabulap],
              required: [id, type, name, summary, provenance, stance]}
      form: {refs: [parts, metre, departures.at], checked: [form, scheme, rules, intended, stance], flavours: [fabulap],
             required: [id, type, name, summary, provenance, stance, form]}
      file: {refs: [component], checked: [path, language, holds, length, sha256, entry, stance], flavours: [fabulac],
             required: [id, type, name, summary, provenance, stance, path]}
      component: {refs: [files, of, exposes, uses], checked: [does, told-in, stance], flavours: [fabulac],
                  required: [id, type, name, summary, provenance, stance]}
      interface: {refs: [defined-in, ruling.made-for, ruling.by], checked: [surface, signature, takes, gives, raises, exported,
                  plain, stated-in, ruling, stance], flavours: [fabulac], required: [id, type, name, summary, provenance, stance, surface],
                  closed: {plain.takes.*: [text, whole number, number, yes-or-no, moment, list, map, record, path, bytes, nothing],
                           plain.gives: [text, whole number, number, yes-or-no, moment, list, map, record, path, bytes, nothing]}}
      structure: {refs: [defined-in, ruling.made-for, ruling.by], checked: [shape, fields, invariants, ruling, stance],
                  flavours: [fabulac], required: [id, type, name, summary, provenance, stance]}
      behaviour: {refs: [of, ruling.made-for, ruling.by], checked: [when, does, edges, errors, intended, ruling, stance],
                  flavours: [fabulac], required: [id, type, name, summary, provenance, stance, does]}
      dependency: {refs: [used-by], checked: [package, version, scope, needed-for, licence, address, resolved, digest, stance],
                   flavours: [fabulac], required: [id, type, name, summary, provenance, stance, scope]}
      setting: {refs: [read-by, ruling.made-for, ruling.by], checked: [key, set-in, default, means, ruling, stance],
                flavours: [fabulac], required: [id, type, name, summary, provenance, stance, set-in]}
      reliance: {refs: [of, used-by, shown-by, ruling.made-for, ruling.by], checked: [on, of, gives, example, shown-by, used-by,
                 entry, stated, contradicted-by, ruling, stance], flavours: [fabulac],
                 required: [id, type, name, summary, provenance, stance, 'on', gives],
                 closed: {'on': [language, runtime, platform, dependency]}}
  R:
    name: Production
    subtitle: Who made the work, with what, and how it changed
    kinds:
      maker: {refs: [who], checked: [capacity, statements, stance], flavours: [fabulan, fabulap, fabulac],
              required: [id, type, name, summary, provenance, stance]}
      change: {refs: [by, touches, release, phase], checked: [at, nature, because, commit, stance], flavours: [fabulan, fabulap, fabulac],
               required: [id, type, name, summary, provenance, stance]}
      phase: {refs: [changes], checked: [began, ended, stance], flavours: [fabulan, fabulap, fabulac],
              required: [id, type, name, summary, provenance, stance]}
      release: {refs: [changes], checked: [version, at, tag, venue, stance], flavours: [fabulan, fabulap, fabulac],
                required: [id, type, name, summary, provenance, stance]}
      means: {refs: [], checked: [what, used-for, version, stance], flavours: [fabulan, fabulap, fabulac],
              required: [id, type, name, summary, provenance, stance]}
      licence: {refs: [], checked: [identifier, file, holder, year, first-line, lane, notice, leave, stance],
                flavours: [fabulan, fabulap, fabulac], required: [id, type, name, summary, provenance, stance],
                closed: {lane: [open, bound, closed]}}
  P:
    name: Propositions
    subtitle: What the work claims, how it can be read, and what it must do
    kinds:
      claim: {refs: [roles.*], checked: [stance, salience, span], flavours: [fabulan, fabulap, fabulac]}
      reading: {refs: [of, grounds.of], checked: [whose, grounds, intended, stance, span], flavours: [fabulan, fabulap],
                required: [id, type, name, summary, provenance, stance, of, whose]}
      case: {refs: [of, made-for, ruling.made-for, ruling.by], checked: [given, expect, stands, from, allowing, ruling, stance,
             span], flavours: [fabulac], required: [id, type, name, summary, provenance, stance, of, given, expect],
             closed: {stands: [outside, inside], from: [test, document, recorded, ruled],
                      allowing: [exit-only, exit-and-stdout, stderr-said-or-not, lines-in-any-order, own-types]}}
      assumption: {refs: [relied-by], checked: [about, checked, if-false, relied-by, carries, stance], flavours: [fabulac],
                   required: [id, type, name, summary, provenance, stance, about],
                   closed: {checked: ['yes', 'no'], carries: [must, need-not]}}
  T:
    name: Transitions
    subtitle: What happens, in order
    note: in a fabulac an event is one step of what happens when the program is used; a use links its events with part-of
    kinds:
      event: {refs: [agent, patient, before, after], checked: [when, span], flavours: [fabulan, fabulap, fabulac]}
  X:
    name: Atems
    subtitle: The tight reductions of passages
    kinds:
      atem: {refs: [of], checked: [line, focus, push, pull, span], flavours: [fabulan, fabulap, fabulac]}

checks:
  load: [load]
  envelope: [duplicate-id, id-grammar, id-module, type, type-prefix, identity-min, provenance, status, visibility,
             ref-grammar, ref-unresolved, closed-list, pending-shape, catalog-key, flavour, flavour-kind]
  own: [code-span, licence-recorded, question-about, question-shape, session-declared, reading-whose,
        interface-signature, case-outcome, requirement-cased, cases-entailed,   # enough/fabula.py (lint_fabula); a
        parts-resolve, interfaces-agree,                  # generic reader lists them as not run; the head's two:
                                                          # enough/fabulac_head.py (MacroCOSM OES 18.4.7, 18.4.8)
        standing, ground-given, ground-cited, stands-alone, nothing-carried, case-outside, cases-cover, ruled,
        round-trip, target-confirmed, surface-answered, apart, evidence-stated]
                                                          # the last thirteen: enough/transconception.py, run only on a
                                                          # fabulac whose catalog says purpose: transconception
  contract: 'fabula-checks: the generic checks above and the own checks, with no error; its old name emf-checks is read
             wherever a manifest, a program or a trace says it'
  severity: {licence-recorded: error, session-declared: warning, reading-whose: warning, interface-signature: warning,
             requirement-cased: warning, cases-cover: warning}               # every other check of transconception is an error (the owner,
                                                 # checkpoint A, 2026-11-18)

# Transconception (MacroCOSM OES 18.4.9): a program carried into another language through its fabulac. The last
# thirteen own checks run only on a fabulac whose catalog says purpose: transconception; the two gates are one function
# each in enough/transconception.py, reporting which checks hold and which do not.
transconception:
  allowances: [exit-only, exit-and-stdout, stderr-said-or-not, lines-in-any-order, own-types]
                                        # an alike ruling's allowing: the judge's closed list, extended only by
                                        # ruling. own-types (sitting 2, 2026-11-18): a value may take the target's own
                                        # type where the kept interface cannot see the difference; the judge compares
                                        # exit status, stdout and stderr exactly, as for kept
  ruled-kinds: ['C:interface', 'C:behaviour', 'C:structure', 'C:setting', 'C:reliance']   # each carries a ruling
  ruling-needs: {alike: [allowing], free: [because|said], kept-wrong: [because|said], changed: [to]}
                                        # a|b: either; said (the person's own words at the sitting) stands as the reason
  stated-entry: '{in, version, at, digest} (version: any patch of the runtime''s minor; digest: the cited page''s), or
                 {nowhere: <what no text states>}; beside the list, contradicted-by: {at, says, said}'
  plain-kinds: [text, whole number, number, yes-or-no, moment, list, map, record, path, bytes, nothing]
  nothing-carried: 200                  # code points: the longest run of the source's own text an item may carry
  cases-cover: 0.6                      # a warning below this share of kept behaviours covered by outside cases
  evidence-levels: '1 builds; 2 the original''s own tests pass, bar the failures its rulings expect; 3 the recorded
                    cases judged and passing; 4 also inputs generated from the plain kinds'
  round-trip-level: 2
  gates:
    ready-to-keep: [standing, ground-given, ground-cited, stands-alone, nothing-carried, case-outside, cases-cover,
                    ruled, round-trip]
    ready-to-entail: [standing, ground-given, ground-cited, stands-alone, nothing-carried, case-outside, cases-cover,
                      ruled, round-trip, target-confirmed]
    per-cshort: [surface-answered, apart, evidence-stated]

# A case as data (MacroCOSM OES 18.4.7, "Cases as the judge"): a P:case is runnable when its given and expect are data for
# one of two surfaces; words stay valid (a prose case: a model step writes its test, marked so). The same fields as a
# transconception's outside cases (enough/transconception.py case_from_item): one notion of a case. Tests are written
# from runnable cases by rules (enough/thym/moves/authored_code.py tests_text), never by the model that writes the code.
# A question about a case's given or expect (its kind text) takes an answer in words or as this data, and refuses data
# no surface knows (enough/dialectic.py case_field). <CASE> in an argument or a variable is the case's own folder, as the outside harness has it.
case-surfaces:
  command:
    given: [files, env, cwd, steps]                    # files: path -> text; env: name -> value (or nothing: unset)
    given-step: [arguments, input]                     # arguments: a list of words; input: text on standard input
    expect: [steps, files]                             # files: path -> text after (or nothing: not there)
    expect-step: [exit, output, error-output]          # exit is required, a whole number
  function:
    given: [calls, arguments]                          # calls: a C:interface id; arguments: parameter -> value
    expect: [value, raises]                            # one of them; raises: {error, message}
    raises: [error, message]                           # error: the class's name (or one of its bases'); message exact

open-questions:
  form: '{pending: "<the question>"}'
  long-form: 'a D:question item about the field (the dialectic); the inline form stays valid and is what a question settles'
  answered-by: 'the dialectic: banks: to (author for prose and verse, maker for code)'
  field-path: keys joined by ".", list positions as [n]
  on-the-whole-item: field path node

renderers:
  - id: claims
    makes: the claims, who and what they are about, and how each is known
    lens: {kind: mermaid, diagram: flowchart, include: [E, K, P], edges: [roles.*, links], class-by: stance,
           shape: {claim: '[ ]', concept: '{{ }}', person: '([ ])', org: '([ ])', place: '([ ])', work: '([ ])',
                   thing: '([ ])'}}
  - id: map
    makes: the whole fabula at a glance
    lens: {kind: mermaid, diagram: mindmap, include: [I, L, E, K, N, C, R, P, T]}
  - {id: text-tree, makes: the text tree, code: [python -m enough.macrocosm tree]}

moves:                                  # Thym (docs/THYM.md, sections 6 and 17.6): the moves this MiniCOSM declares
  - name: derive
    takes: [text]
    gives: fabula
    asks: true
    contract: [span-resolves, stance-closed, terms-grounded, coverage, emf-checks, provenance]
    scaffold: rules-twin
    code: enough.thym.moves.emf:derive
    says: a text decompiled into its fabula, the EMF twin
    thym-1:                             # thym 1: a text as prose, verse or code, and a folder folded (THYM 6.3, 20.5, 20.6)
      takes: ['text | folder']
      modifiers: {as: 'prose | verse | code', with: fabula}
      contract: [span-resolves, stance-closed, terms-grounded, coverage, fabula-checks, provenance]
      contract-when:                    # a rule may also say with: <type>, met only by a call that writes that with
        - {as: [code], contract: [code-span, outline-cited, coverage, terms-grounded, stance-closed, fabula-checks, provenance]}
        - {takes: folder, contract: [fold-grounded, atem-shape, licence-recorded, fabula-checks, provenance]}
        - {as: [verse], with: fabula, contract: [span-resolves, stance-closed, terms-grounded, coverage, fabula-checks, provenance, nothing-lost]}
      scaffold-when:                    # a folder has none: nothing but a model reads intent, and --rules refuses it
        - {as: [code], scaffold: file-outline}
        - {takes: folder, scaffold: none}
  - name: entail                        # `tell`, its earlier spelling, reads as entail and is never written (THYM 6.3)
    takes: ['fabula | item | volume']
    gives: short
    modifiers: {as: order, by: order, with: morph}
    asks: true
    contract: [coverage, no-invention, stance-kept, scales-met, footer, provenance]
    scaffold: outline
    code: enough.thym.moves.emf:entail
    says: an entailment of the fabula, in an order, in a morph
    thym-1:                             # thym 1: a fabulac entails code (a cshort, a folder) or a catem (THYM 6.3, 20.7),
                                        # or its cases file for the outside judge (transconception, THYM 20.10; no model),
                                        # or a layout and a cshort in another language (`in`, a string; THYM 20.10)
      modifiers: {as: 'order | code | line | overview | manual | cases | layout', by: order, in: string,
                  with: 'morph | short'}
      gives-when:
        - {as: [code], gives: folder}
        - {as: [cases], gives: text}
        - {as: [layout], gives: short}
      contract-when:
        - {as: [code], with: short, contract: [target-confirmed, files-present, surface-answered, apart, footer, provenance]}
        - {as: [code], contract: [parses, interfaces-present, files-present, footer, cases-entailed, provenance]}
        - {as: [layout], contract: [target-confirmed, surface-answered, no-invention, footer, provenance]}
        - {as: [line, overview, manual], contract: [coverage, no-invention, quotes-held, uses-told, footer, provenance]}
        - {as: [cases], contract: [cases-whole, provenance]}
      scaffold-when:                    # code has none: --rules refuses it; cases needs no model, so its scaffold is itself
        - {as: [line, overview, manual], scaffold: uses-outline}
        - {as: [code], scaffold: none}
        - {as: [cases], scaffold: cases-file}
        - {as: [layout], scaffold: none}
  - name: atem
    takes: ['text | fabula | short | item']
    gives: atem
    asks: true
    contract: [atem-shape, span-resolves, provenance]
    scaffold: first-sentence
    code: enough.thym.moves.emf:atem
    says: the line, focus, push and pull of a text or a passage
  - name: expand
    takes: [atem]
    gives: short
    modifiers: {with: fabula, to: words}
    asks: true
    contract: [coverage, no-invention, stance-kept, length, span-inside, provenance]
    code: enough.thym.moves.emf:expand
    says: an atem opened out into a short of a given length, from its fabula
  # thym 1 only (since: 1; THYM 6.3, 20.6): the two rules-only stages of a fabulac's build
  - name: survey
    takes: [folder]
    gives: fabula
    contract: [files-found, code-span, licence-recorded, fabula-checks, provenance]
    code: enough.thym.moves.code:survey
    says: a folder of Python read by its syntax into the outline of a fabulac, nothing run
    since: 1
  - name: history
    takes: [folder]
    gives: fabula
    modifiers: {with: fabula}
    contract: [history-grounded, fabula-checks, provenance]
    code: enough.thym.moves.code:history
    says: the fabula so far with a clone's history, its changes in episodes, its releases and its makers
    since: 1
  # thym 1 only (since: 1; THYM 6.3, 20.9): the fabulap's helper moves, one `as` word per axis of a poem. scan reads
  # by rule (no model; a scan with an as adds to the fabulap it is given); construe asks a model, has no scaffold,
  # and so --rules refuses it at plan time
  - name: scan
    takes: [text]
    gives: fabula
    modifiers: {as: 'rhyme | sound | recurrence | form', with: fabula}
    contract: [lines-found, scansion-grounded, span-resolves, fabula-checks, provenance]
    contract-when:
      - {as: [rhyme, sound, recurrence], contract: [sound-grounded, nothing-lost, fabula-checks, provenance]}
      - {as: [form], contract: [form-grounded, nothing-lost, fabula-checks, provenance]}
    code: enough.thym.moves.verse:scan
    says: a poem read by rule, its lines, stresses, metre, rhymes, sounds, repetitions and form
    since: 1
  - name: construe
    takes: [text]
    gives: fabula
    modifiers: {as: 'figure | image | allusion | voice | turn | meaning | ambiguity', with: fabula}
    asks: true
    contract: [span-resolves, no-invention, stance-kept, coverage, terms-grounded, nothing-lost, fabula-checks, provenance]
    code: enough.thym.moves.verse:construe
    says: one axis of a poem read by a model, every reading held as the model's own
    since: 1
  # thym 1 only (since: 1; THYM 6.3, 20.11): authoring a fabulac. author begins one from a brief (a model places what
  # the brief's headings do not; the rules read the rest) or, with no operand, by rules alone: the catalog and what
  # the person said in beginning it. add, compare and uncovered are its helpers, by rules. The moves live in
  # enough/thym/moves/author.py; authored-source is Thym's own check (THYM 7.3), held there too.
  - name: author
    takes: ['text | nothing']                # the brief, or nothing: an interview (a last operand that may be left out)
    gives: fabula
    modifiers: {as: 'tool | library | service'}
    asks: true
    contract: [authored-source, fabula-checks, provenance]
    scaffold: catalog-alone
    scaffold-when:                          # a brief: none (a model places what the rules cannot); no brief: the move
      - {takes: text, scaffold: none}
    code: enough.thym.moves.author:author
    says: an authored fabulac begun, from the person's brief or from nothing, its every item an axiom
    since: 1
  - name: add
    takes: [string]
    gives: fabula
    modifiers: {as: 'requirement | decision | case | interface', with: fabula}
    contract: [authored-source, nothing-lost, ids-unique, fabula-checks, provenance]
    code: enough.thym.moves.author:add
    says: the person's own sentence written into the fabulac they authored, as a new item of that kind
    since: 1
  - name: compare
    takes: [fabula]
    gives: report
    modifiers: {with: fabula}
    code: enough.thym.moves.author:compare
    says: what differs between two fabulacs, item by item
    since: 1
  - name: uncovered
    takes: [fabula]
    gives: list of item
    code: enough.thym.moves.author:uncovered
    says: the requirements a program must meet that no case shows
    since: 1
  # thym 1 only (since: 1; Thym 20.10): a transconception's moves (enough/thym/moves/transconceive.py)
  - name: ground
    takes: [folder]
    gives: fabula
    modifiers: {with: fabula}
    contract: [ground-cited, code-span, nothing-lost, fabula-checks, provenance]
    code: enough.thym.moves.transconceive:ground
    says: the fabula so far with a reliance for each ground entry the syntax shows, each citing its gift, nothing run
    since: 1
  - name: weigh                         # Thym 6.3, 20.10: rules from the language's target table, then a model
    takes: [fabula]
    gives: fabula
    modifiers: {in: string}
    asks: true
    contract: [target-weighed, no-invention, fabula-checks, provenance]
    code: enough.thym.moves.transconceive:weigh
    says: the fabulac with one dated N:target for the language, its twelve points scored, what provides each thing kept, its verdict
    since: 1

# The opening questions (MacroCOSM's dialectic, pin P4): one bank per flavour, in plain words and in no one's voice.
# about names a module (M), a kind (M:kind) or a kind's field (M:kind#field). A question about a module is asked of
# the volume once; about a kind, of each item of it; about a field, of each item where the field is absent or pending,
# and {name} is filled from the item. The answer is written as the dialectic says (docs/fabula-pins-schema.md part 5).
# only-where: {<field>: [words]} asks an entry only of items whose field holds one of the words; sets: {<field>:
# <value>} gives a new item written from an answer about a module the fields the answer cannot (a device's figure).
# A yes-no, number, date, ref or span answer is always about a field (MacroCOSM OES 18.6.4): an entry about a module
# or a kind asks for text or a choice.
dialectic:
  writes: 'the field or item a question is about, with provenance {mode: dialectic, sources: [D:session/<id>], confidence}'
  answer-kinds: [text, choice, yes-no, number, date, ref, span]   # a text question about a case's given or expect takes
                                                                 # words, or data for a surface (case-surfaces below)
  entry-fields: [id, about, asks, kind, options, to, why, many, hint, writes, sets, only-with, only-where, at-most, batch,
                 stage, brief]
  banks:
    fabulan:
      for: {flavour: fabulan}
      to: author
      questions:
        - {id: occasion, about: I, asks: "What prompted this text: an event, a request, a need?", kind: text, why: missing, writes: occasion}
        - {id: influence, about: I, asks: "Which writers, works or traditions shaped it?", kind: text, why: missing, writes: influence}
        - {id: allusion, about: I:allusion, asks: "Did you mean the echo of {name} here?", kind: yes-no, why: intent}
        - {id: aim, about: N, asks: "What should a reader know, believe or do after reading it?", kind: text, why: intent, writes: aim}
        - {id: audience, about: N, asks: "Whom did you write it for?", kind: text, why: missing, writes: audience}
        - {id: exclusion, about: N, asks: "What did you choose to leave out, and why?", kind: text, why: intent, writes: exclusion}
        - {id: decision, about: N, asks: "Which choice in it was hardest to make?", kind: text, why: intent, writes: decision}
        - {id: voice, about: C:voice, asks: "Who is speaking here, and to whom?", kind: text, why: unsure}
        - {id: parts, about: C, asks: "Why is it divided the way it is?", kind: text, why: intent, writes: N:decision}
        - {id: maker, about: R, asks: "Who wrote it, and who else had a hand in it?", kind: text, why: missing, writes: maker}
        - {id: release, about: R, asks: "Where and when was it first published?", kind: text, why: missing, writes: release}
        - {id: drafts, about: R, asks: "What changed between drafts?", kind: text, why: missing, writes: change}
        - {id: licence, about: R, asks: "May others copy it, and on what terms?", kind: text, why: missing, writes: licence}
        - {id: weight, about: P, asks: "Which claim matters most to you, and why?", kind: text, why: intent, writes: N:aim}
        - {id: stand-by, about: P:claim, asks: "Would you still stand behind this: {name}?", kind: yes-no, why: unsure}
        - {id: refuse, about: P, asks: "Is there a reading of it you would refuse?", kind: text, why: intent, writes: reading}
        - {id: sense, about: L:term#sense, asks: "Do you use {name} in a sense of your own? Which?", kind: text, why: unsure}
    fabulap:
      for: {flavour: fabulap}
      to: author                  # an expert in the poet's work when the author cannot be asked
      questions:
        # inspiration (I)
        - {id: spark, about: I, asks: "What set the poem going: something seen, heard, read, or a line that came first?", kind: text, why: missing, writes: occasion}
        - {id: ear, about: I, asks: "Which poets or poems were in your ear while you wrote it?", kind: text, why: missing, writes: influence}
        - {id: for-whom, about: I, asks: "Was it written for a person or an occasion?", kind: text, why: missing, writes: occasion}
        - {id: tradition, about: I, asks: "Did you write it in, or against, a tradition or a form: an elegy, a hymn, a ballad, a sonnet?", kind: text, why: intent, writes: influence}
        - {id: echo, about: I:allusion#roles.to, asks: "Does {name} echo another text on purpose? Which one?", kind: text, why: intent}
        # intent (N)
        - {id: last-line, about: N, asks: "What did you want a reader to feel by the last line?", kind: text, why: intent, writes: aim}
        - {id: listener, about: N, asks: "Whom did you imagine reading it, or hearing it?", kind: text, why: missing, writes: audience}
        - {id: unsaid, about: N, asks: "Is there something the poem is careful not to say?", kind: text, why: intent, writes: exclusion}
        # voice (C:voice)
        - {id: speaker, about: C:voice#roles.speaker, asks: "Who speaks the poem: you, a character, or no one in particular?", kind: text, why: unsure}
        - {id: addressee, about: C:voice#roles.addressee, asks: "Whom does the poem address, and is that one listening?", kind: text, why: unsure}
        - {id: overheard, about: C:voice#roles.listener, asks: "Is anyone meant to overhear {name}, beside the one it speaks to?", kind: text, why: missing, at-most: 2}
        - {id: shift, about: C:voice, asks: "Does the speaker or the tone change anywhere? Where?", kind: text, why: unsure, writes: voice}
        - {id: tone, about: C:voice#tone, asks: "In what tone should {name} be heard?", kind: text, why: unsure}
        # sound and form (C:line, C:rhyme, C:metre, C:form, C:part); breaks and stanza fill no field of a line or a
        # part: an answer writes the answerer's P:reading of them, never a new line or part (MacroCOSM OES 18.4.6)
        - {id: stresses, about: C:line#stresses, asks: "How should line {number} be read aloud: where do the stresses fall?", kind: text, why: unsure}
        - {id: breaks, about: C:line, asks: "Why do the lines break where they do?", kind: text, why: intent, writes: P:reading}
        - {id: stanza, about: C:part, asks: "Why this stanza shape, and these lengths?", kind: text, why: intent, writes: P:reading}
        - {id: rhyme, about: C:rhyme, asks: "Was the rhyme (or its absence) chosen early or late, and why?", kind: text, why: intent}
        - {id: metre-break, about: C:metre#departures, asks: "Where the metre breaks, is that on purpose?", kind: yes-no, why: intent}
        - {id: form, about: C:form#intended, asks: "Did you set out to write it as {name}?", kind: yes-no, why: intent}
        # figure, image, turn (C:device)
        - {id: meant, about: C:device#intended, asks: "Did you mean {name}?", kind: yes-no, why: intent, at-most: 6}
        - {id: image, about: C:device, only-where: {figure: [image]}, asks: "Which image carries the most weight for you, and why?", kind: text, why: intent, writes: N:aim}
        - {id: stands-for, about: C:device, only-where: {figure: [symbol, metaphor, image]}, asks: "Is {name} meant to stand for something beyond itself? What?", kind: text, why: ambiguous}
        - {id: turn, about: C, asks: "Where does the poem turn, and from what to what?", kind: text, why: intent, writes: device, sets: {figure: turn}}
        # reference and production (R)
        - {id: editor, about: R, to: expert, asks: "Is every word as the poet left it, or did an editor or a printer change any? Which?", kind: text, why: missing, writes: change}
        - {id: cut, about: R, asks: "What did you cut from earlier drafts, and why?", kind: text, why: missing, writes: change}
        - {id: drafts, about: R, asks: "How many drafts did it go through, and what changed most?", kind: text, why: missing, writes: change}
        - {id: published, about: R, asks: "Where and when was it first published or performed?", kind: text, why: missing, writes: release}
        # what is left open (P, L)
        - {id: both, about: P:reading#intended, asks: "Is this reading one you meant: {name}?", kind: yes-no, why: ambiguous, at-most: 6}
        - {id: refuse, about: P, asks: "Is there a reading of the poem you would refuse?", kind: text, why: intent, writes: reading}
        - {id: title, about: P, asks: "How does the title change the way the poem reads?", kind: text, why: intent, writes: reading}
        - {id: word, about: L:term#sense, asks: "Is {name} used in an old, regional or private sense?", kind: text, why: unsure}
        # a lyric
        - {id: music, about: R, asks: "Is it sung? To what tune or setting, and whose?", kind: text, why: missing, writes: means}
        - {id: hook, about: C:device#intended, only-where: {figure: [hook]}, asks: "Is {name} the hook, the line you want a listener to keep?", kind: yes-no, why: intent}
        - {id: sung, about: C, asks: "Where does the tune move a word's stress, or hold one syllable over several notes?", kind: text, why: missing, writes: device, sets: {figure: sung stress}}
        - {id: performed, about: R, asks: "Is it sung as written, or are lines repeated, cut or added when it is performed?", kind: text, why: missing, writes: change}
    fabulac:
      for: {flavour: fabulac, source: [folder, none]}   # a fabulac decompiled from a folder (or standalone); never an
      to: maker                                         # authored one: its questions are about code that exists
      questions:
        - {id: modelled-on, about: I, asks: "What existing tool or program was this modelled on, or made to replace?", kind: text, why: missing, writes: influence}
        - {id: prompted, about: I, asks: "What problem or moment set it going?", kind: text, why: missing, writes: occasion}
        - {id: for-whom, about: N, asks: "Who is it for, and what do they already know?", kind: text, why: missing, writes: audience}
        - {id: never, about: N, asks: "What must it never do, whatever a user asks?", kind: text, why: intent, writes: requirement}
        - {id: left-out, about: N, asks: "What is deliberately left out, for now or for good?", kind: text, why: intent, writes: exclusion}
        - {id: why-this, about: N:decision#because, asks: "Why was {name} chosen over the alternatives?", kind: text, why: intent, at-most: 5}
        - {id: tried, about: N:decision#over, asks: "What else was tried for {name} and dropped?", kind: text, why: missing, at-most: 5}
        - {id: intended, about: C:behaviour#intended, asks: "Is this behaviour intended, or an accident users now rely on: {name}?", kind: yes-no, why: intent, at-most: 5}
        - {id: public, about: C:interface#exported, asks: "Is {name} meant for others to call, or internal?", kind: yes-no, why: unsure, at-most: 5}
        - {id: bad-input, about: C:interface, asks: "What should {name} do with input it does not expect?", kind: text, why: missing, only-with: takes, at-most: 5}
        - {id: settings, about: C:setting, asks: "Is {name} meant to be changed by users?", kind: yes-no, why: unsure, at-most: 5}
        - {id: first-read, about: C, asks: "Which file should a newcomer read first, and why?", kind: text, why: missing, writes: N:audience}
        - {id: changed, about: R:change#because, asks: "Why was this change made: {name}?", kind: text, why: missing, at-most: 5}
        - {id: maintains, about: R, asks: "Who maintains it now?", kind: text, why: missing, writes: maker}
        - {id: licence, about: R:licence#identifier, asks: "Under which licence may it be used?", kind: text, why: missing}
        - {id: must-keep, about: P, asks: "Which example of use must keep working exactly as it does?", kind: text, why: intent, writes: case}
        - {id: worry, about: P:case, asks: "Which test, if it failed, would worry you most, and why?", kind: text, why: intent, writes: N:requirement, sets: {force: must}}
    # An authored fabulac's interview (MacroCOSM OES 18.4.7, "How a fabulac is authored"; Thym 20.11), asked only of a
    # fabulac whose source is the authored form, by its author. The entries carry the interview's order: `stage` names
    # the stage each belongs to, and the stages go in the order their entries first appear: what it is for and for
    # whom; the ways in; what it needs and the settings it reads; what it leaves out on purpose; the cases; the open
    # questions. A stage is raised only when the one before it has landed (every question of the volume answered and
    # settled, and every open field asked), so the person meets one stage at a time; the page shows them one or two
    # at a time. An entry about a module writes the kind `writes` names, with `sets` giving what the answer cannot (an
    # open field asks it next, in the same stage), and is not asked when the volume holds that item already (the
    # brief gave it). `brief` lists the headings of a written brief whose sections answer the entry by rule: each list
    # item, or each paragraph, under such a heading is one item, in the person's own words (structured-intake); the
    # paragraphs before the first heading answer `aim`. Every item an answer or the brief writes is an axiom.
    fabulac-authored:
      for: {flavour: fabulac, source: authored}
      to: author
      questions:
        # what it is for, and for whom
        - {id: aim, stage: for, about: N, asks: "What should {name} do, in a sentence or two: what does a person have once it has run?", kind: text, why: intent, writes: aim, brief: [what it is for, what it does, aim, aims, purpose]}
        - {id: audience, stage: for, about: N, asks: "Who is {name} for, and what do they already know?", kind: text, why: missing, writes: audience, brief: [for whom, who it is for, audience, who]}
        - {id: use, stage: for, about: N, asks: "Name one thing a person will do with {name}, from start to end.", kind: text, why: missing, writes: use, brief: [uses, use, what a person does with it]}
        - {id: occasion, stage: for, about: I, asks: "What set you to make {name}: a problem, a moment, a need?", kind: text, why: missing, writes: occasion, brief: [why, occasion, what prompted it]}
        - {id: licence, stage: for, about: R:licence#identifier, asks: "Under which licence will you offer the program to others: MIT, Apache-2.0, or another? Give its short name.", kind: text, why: missing}
        # the ways in
        - {id: way-in, stage: ways-in, about: C, asks: "How does a person or another program reach {name}: a command and its arguments, or a function and what it takes? Name one way in.", kind: text, why: missing, writes: interface, sets: {surface: {pending: "Is it a command (a person types it) or a function (a program calls it)? Say command or function."}}, brief: [ways in, way in, commands, interface, interfaces]}
        - {id: signature, stage: ways-in, about: C:interface#signature, asks: "What is the exact signature of {name}: its name, and every argument it takes, in order?", kind: text, why: missing}
        # what it needs, and the settings it reads
        - {id: needs, stage: needs, about: C, asks: "Does {name} need anything besides Python and its standard library to run? Name one thing it needs.", kind: text, why: missing, writes: dependency, sets: {scope: run-time}, hint: "decline this question when it needs nothing else", brief: [needs, what it needs, dependencies, requires]}
        - {id: python, stage: needs, about: C:dependency#version, asks: "Which version of {name} at least?", kind: text, why: missing}
        - {id: setting, stage: needs, about: C, asks: "Which setting will {name} read: an option on its command line, a variable of the environment, a file? Name one.", kind: text, why: missing, writes: setting, sets: {set-in: {pending: "Where is it set: an option, the environment, a file, or a constant? Say option, environment, file or constant."}}, hint: "decline this question when it reads none", brief: [settings, setting, options, configuration]}
        # what it leaves out on purpose
        - {id: left-out, stage: left-out, about: N, asks: "What will {name} not do, on purpose, for now or for good?", kind: text, why: intent, writes: exclusion, brief: [leaves out, left out, what it leaves out, not doing, out of scope, exclusions, non-goals]}
        - {id: must, stage: left-out, about: N, asks: "What must {name} always do, and what must it never do, whatever a person asks of it? Name one.", kind: text, why: intent, writes: requirement, sets: {force: must}, brief: [requirements, must, always, never, must never]}
        # the cases
        - {id: case, stage: cases, about: P, asks: "Give one example {name} must get right: what is given (a command and its arguments, or a call), and what is expected back.", kind: text, why: missing, writes: case, sets: {of: {pending: "Which way in, or which use, is this case of? Name it by its id."}, given: {pending: "What is given: for a command, its steps (each the arguments and any input) and the files it starts with; for a function, the interface it calls and the value of each argument?"}, expect: {pending: "What is expected back: for a command, each step's exit, output and error output, and the files after; for a function, the value it returns or the error it raises?"}}, brief: [cases, case, examples, example]}
        # the open questions: a requirement the program must meet that no case shows yet (asked once the cases are
        # in), and what is still undecided
        - {id: checked-by, stage: open, about: N:requirement#checked-by, only-where: {force: [must]}, asks: "Which case shows that {name} holds? Name the case by its id.", kind: ref, why: missing}
        - {id: open, stage: open, about: N, asks: "What is still undecided about {name}: a choice you have not made yet?", kind: text, why: intent, writes: decision, sets: {chose: {pending: "not decided yet: what will you choose?"}}, hint: "decline this question when nothing is", brief: [open questions, undecided, questions]}
    # A transconception's three banks (MacroCOSM 18.4.9, 18.6.6), asked only of a fabulac whose catalog says
    # purpose: transconception, and answered by its transconceiver. standing: who rules, the source's terms and the
    # transconceiver's statements about them (who rules is asked only while nobody does; the leave only of a closed
    # lane). target: asked once of the N:target named, and of none when no target is named (its version and
    # conditions, then each of the twelve points a weighing scored). rulings: one question per interface, behaviour, reliance, setting, structure and ruled case that still
    # needs a ruling for the target in question, in this order and riskiest first within each, each proposing a
    # ruling ({proposed}; {for} names its target when it is made for one); batch: true asks once of every item with
    # the same proposal and scope. A ruling question's answer is a choice: as proposed, or a ruling word, the
    # person's own words after it giving the allowance, the reason or what it is changed to.
    transconception-standing:
      for: {purpose: transconception}
      to: transconceiver
      questions:
        - {id: who-rules, about: R, asks: "Who will rule what the next program keeps of {name}: someone who made it, maintains it or knows it well? Say who, and how they know it.", kind: text, why: missing, writes: maker, sets: {capacity: transconceiver}}
        - {id: lane, about: R:licence#lane, asks: "Do the terms of {name} let anyone make a new work from the source and pass it on (open), bind such a work to the same terms (bound), or let the source be read and not made into a new work (closed)?", kind: choice, options: [open, bound, closed], why: missing}
        - {id: leave, about: R:licence#leave, only-where: {lane: [closed]}, asks: "The terms of {name} let the source be read, not made into a new work. Has its holder asked for this, or given leave in writing? Where is that leave kept?", kind: text, why: missing}
        - {id: licence, about: R:maker#statements.licence, only-where: {capacity: [transconceiver]}, asks: "Under which licence did the source come to you?", kind: text, why: missing}
        - {id: lane-said, about: R:maker#statements.lane, only-where: {capacity: [transconceiver]}, asks: "Do the source's terms let you make a new program from it and pass it on? Say why, in your own words.", kind: text, why: missing}
        - {id: confidential, about: R:maker#statements.confidential, only-where: {capacity: [transconceiver]}, asks: "Did any of the source, or anything about it, reach you in confidence, or on terms other than its licence?", kind: text, why: missing}
        - {id: programs, about: R:maker#statements.programs, only-where: {capacity: [transconceiver]}, asks: "What will the new program be called, in each language it is written in?", kind: text, why: missing}
        - {id: attribution, about: R:maker#statements.attribution, only-where: {capacity: [transconceiver]}, asks: "Whose notices and credit will the new program carry?", kind: text, why: missing}
    transconception-target:
      for: {purpose: transconception}
      to: transconceiver
      questions:
        - {id: version, about: N:target#version, asks: "Which version of {language} should the new program be written for?", kind: text, why: missing}
        - {id: conditions, about: N:target#conditions, asks: "On what conditions may the new program be written in {language}: may it use libraries others wrote, each pinned and named, and what must it never lean on?", kind: text, why: missing}
        # the twelve points (MacroCOSM 18.4.9), once weighed: each score the weighing gave (by rules or a model,
        # weighed[n].answered) is put to the transconceiver, whose word is kept in weighed[n].ruled. Points 1, 4, 5
        # are gates: a score of 0 makes the target not feasible.
        - {id: stewardship, about: 'N:target#weighed[0].ruled', only-with: 'weighed[0].score', asks: "Point 1, a gate: does {language} have stewardship that outlives one company? The weighing scored it {weighed[0].score} of 3: {weighed[0].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: specification, about: 'N:target#weighed[1].ruled', only-with: 'weighed[1].score', asks: "Point 2: does {language} have a written specification, and more than one implementation? The weighing scored it {weighed[1].score} of 3: {weighed[1].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: old-programs-build, about: 'N:target#weighed[2].ruled', only-with: 'weighed[2].score', asks: "Point 3: does {language} promise that old programs keep building? The weighing scored it {weighed[2].score} of 3: {weighed[2].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: provided, about: 'N:target#weighed[3].ruled', only-with: 'weighed[3].score', asks: "Point 4, a gate: is everything the program leans on provided in {language}? The weighing scored it {weighed[3].score} of 3: {weighed[3].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: runs-and-ships, about: 'N:target#weighed[4].ruled', only-with: 'weighed[4].score', asks: "Point 5, a gate: does a program in {language} run where it must and ship as it must? The weighing scored it {weighed[4].score} of 3: {weighed[4].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: fits-shapes, about: 'N:target#weighed[5].ruled', only-with: 'weighed[5].score', asks: "Point 6: does {language} fit the program's shapes? The weighing scored it {weighed[5].score} of 3: {weighed[5].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: safe-by-default, about: 'N:target#weighed[6].ruled', only-with: 'weighed[6].score', asks: "Point 7: is {language} safe by default? The weighing scored it {weighed[6].score} of 3: {weighed[6].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: tools-check, about: 'N:target#weighed[7].ruled', only-with: 'weighed[7].score', asks: "Point 8: can the tools of {language} check what the fabulac states? The weighing scored it {weighed[7].score} of 3: {weighed[7].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: agent-skill, about: 'N:target#weighed[8].ruled', only-with: 'weighed[8].score', asks: "Point 9: how well does the writing agent write {language}? The weighing scored it {weighed[8].score} of 3: {weighed[8].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: budgets, about: 'N:target#weighed[9].ruled', only-with: 'weighed[9].score', asks: "Point 10: does a program in {language} meet the budgets? The weighing scored it {weighed[9].score} of 3: {weighed[9].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: readable, about: 'N:target#weighed[10].ruled', only-with: 'weighed[10].score', asks: "Point 11: can the people who keep the program read {language}? The weighing scored it {weighed[10].score} of 3: {weighed[10].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
        - {id: can-be-left, about: 'N:target#weighed[11].ruled', only-with: 'weighed[11].score', asks: "Point 12: could the program leave {language} for another language later? The weighing scored it {weighed[11].score} of 3: {weighed[11].evidence} Is that right? Say yes, or give your score and why.", kind: text, why: unsure}
    transconception-rulings:
      for: {purpose: transconception}
      to: transconceiver
      counters:
        ruled: "That ruling needs one more thing: for alike, which allowance (exit-only, exit-and-stdout, stderr-said-or-not, lines-in-any-order, own-types); for changed, what it is changed to. Which ruling, with it?"
      questions:
        - {id: interface, about: C:interface#ruling, asks: "Must the next program{for} offer {name} exactly as it is? Proposed: {proposed}.", kind: choice, options: [as proposed, kept, alike, free, kept-wrong, changed], why: missing, batch: true}
        - {id: behaviour, about: C:behaviour#ruling, asks: "Must the next program{for} do exactly this: {name}? Proposed: {proposed}.", kind: choice, options: [as proposed, kept, alike, free, kept-wrong, changed], why: missing, batch: true}
        - {id: reliance, about: C:reliance#ruling, asks: "Must the next program{for} keep what this gives: {name}? Proposed: {proposed}.", kind: choice, options: [as proposed, kept, alike, free, kept-wrong, changed], why: missing, batch: true}
        - {id: setting, about: C:setting#ruling, asks: "Must the next program{for} keep the setting {name} as it is? Proposed: {proposed}.", kind: choice, options: [as proposed, kept, alike, free, kept-wrong, changed], why: missing, batch: true}
        - {id: structure, about: C:structure#ruling, asks: "Must the next program{for} keep the shape of {name} as it is? Proposed: {proposed}.", kind: choice, options: [as proposed, kept, alike, free, kept-wrong, changed], why: missing, batch: true}
        - {id: case, about: P:case#ruling, only-with: ruling, asks: "Must the next program{for} give what this case records: {name}? Proposed: {proposed}.", kind: choice, options: [as proposed, kept, alike, free, kept-wrong, changed], why: missing, batch: true}

extension:
  status: not built
