        "gte_32gb": 32768,
        "gte_16gb": 8192,
        "lt_16gb": 4096
      }
    }
  },

  "install_tiers": [
    {"n": 1, "models": ["g40-04"],                                   "label": "just G40-04 (smallest, fits anywhere)"},
    {"n": 2, "models": ["g40-04", "q35-09"],                         "label": "+ Q35-09 (balanced mid-size)"},
    {"n": 3, "models": ["g40-04", "q35-09", "g40-26"],               "label": "+ G40-26 (Gemma MoE, flagship)"},
    {"n": 4, "models": ["g40-04", "q35-09", "g40-26", "q36-27"],    "label": "+ Q36-27 (Qwen dense, coding flagship)"}
