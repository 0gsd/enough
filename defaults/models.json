      "gguf_filename": "gemma-4-26B-A4B-it-Q4_K_M.gguf",
      "gguf_url": "https://huggingface.co/ggml-org/gemma-4-26B-A4B-it-GGUF/resolve/main/gemma-4-26B-A4B-it-Q4_K_M.gguf",
      "disk_gb_approx": 15.6,
