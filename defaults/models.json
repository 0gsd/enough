      "gguf_filename": "Qwen_Qwen3.6-27B-Q4_K_M.gguf",
      "gguf_url": "https://huggingface.co/bartowski/Qwen_Qwen3.6-27B-GGUF/resolve/main/Qwen_Qwen3.6-27B-Q4_K_M.gguf",
      "disk_gb_approx": 16.5,
