# An answers volume (Thym 22.2): the delta a page writes beside the twin it answers. One session; for each question
# answered, its id, its new state and its new answers. Read only as a delta, never checked as a fabula on its own.
oes: fabula/1
macrocosm: 0.5.4
id: fabula/guides--close-md
nodes:
  - id: D:session/session-2
    type: session
    at: 2026-11-05T12:00:00Z
    with: {to: author, who: Meadow's head of support}
    through: person
    asked: [D:question/audience]
    answered: [D:question/audience]
    skipped: []
  - id: D:question/audience
    state: answered
    answers:
      - {at: 2026-11-05T12:01:30Z, by: author, says: "For owners first. Support reads it too, so they say the same thing on the phone.", value: "restaurant owners who are Meadow's customers, and Meadow's support staff", confidence: 1, session: D:session/session-2}
