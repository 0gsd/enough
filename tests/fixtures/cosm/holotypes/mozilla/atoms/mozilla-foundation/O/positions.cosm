# O: positions are seats; who sits in them is never written. Only the board, its committees and the executive seat have a published line.
nodes:
  - id: O:position/board-of-directors
    type: position
    name: Board of Directors
    summary: The Foundation's governing body; the top of the chart.
    roles: ['O:role/Board-of-Directors']
    primary: O:role/Board-of-Directors
    reports-to: none
    template: true
    instances: 10
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://stateof.mozilla.org/pdf/Mozilla%20Foundation_Form_990_2024.pdf'], confidence: 0.9, state: known}

  - id: O:position/audit-committee
    type: position
    name: Audit Committee
    summary: Standing board committee.
    roles: ['O:role/Audit-Committee']
    primary: O:role/Audit-Committee
    reports-to: O:position/board-of-directors
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://stateof.mozilla.org/pdf/Mozilla%20Foundation_Form_990_2024.pdf'], confidence: 0.9, state: known}

  - id: O:position/investment-committee
