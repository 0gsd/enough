    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://stateof.mozilla.org/pdf/Mozilla%20Foundation_Form_990_2024.pdf'], confidence: 0.9, state: known}

  - id: O:position/executive-director
    type: position
    name: Executive Director
    summary: The chief executive seat. Reporting to the board is the conventional line; the pages read do not state it.
    roles: ['O:role/Executive-Director']
    primary: O:role/Executive-Director
    reports-to: O:position/board-of-directors
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://www.mozillafoundation.org/en/meet-mozilla/', 'https://stateof.mozilla.org/pdf/Mozilla%20Foundation_Form_990_2024.pdf'], confidence: 0.7, state: known}

