  - id: P:offering/nothing-personal
    type: offering
    name: Nothing Personal
    summary: A counterculture magazine made by people, with long-form essays, satirical advice and hands-on product reviews of the privacy of consumer technology, supported by The Onion.
    owner: O:role/Director-Communications
    confidence: 0.8
    sources: ['https://www.mozillafoundation.org/en/what-we-do/imagine/', 'https://www.mozillafoundation.org/en/nothing-personal/privacy-not-included-sunset/']
    visibility: public
    parts: ['P:product/nothing-personal-magazine', 'P:service/product-reviews', 'P:service/privacy-not-included']
    economics:
      price: none
    affect:
      audience: M:audience/magazine-readers
      elicits:
        - {feeling: curiosity, when: reading an essay about online life}
        - {feeling: confidence, when: choosing a gadget with its privacy tested}
      tone: [witty, plain]
    mattering:
      to-the-whole: 'The Imagine page: it disrupts dominant tech narratives; the magazine also carries the privacy product reviews.'
      weight: supporting
      inside:
        - who: ['O:role/Director-Communications']
          because: The magazine carries on the Foundation's product privacy work after Privacy Not Included was moved into it.
          confidence: 0.5
      chosen:
        - who: ['M:audience/magazine-readers']
          because: Readers get hands-on privacy testing of popular consumer tech.
          confidence: 0.5
      prospective:
        - who: ['M:audience/magazine-readers']
          because: The magazine promises the insight to make good tech choices.
          confidence: 0.5

