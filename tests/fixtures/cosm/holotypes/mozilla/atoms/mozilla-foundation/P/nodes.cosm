  - id: P:offering/common-voice
    type: offering
    name: Common Voice
    summary: 'A flagship Foundation initiative to mitigate bias in AI by democratising speech technology: a web app where people donate their voices, and public datasets that, since October 2025, are distributed through Mozilla Data Collective.'
    owner: O:role/Executive-Director
    confidence: 0.8
    sources: ['https://www.mozillafoundation.org/en/common-voice/', 'https://www.mozillafoundation.org/en/what-we-do/co-create/', 'https://github.com/common-voice/common-voice', 'https://huggingface.co/spaces/mozilla-foundation/README/blob/main/README.md']
    visibility: public
    parts: ['P:product/common-voice-platform', 'P:service/common-voice-datasets']
    economics:
      price: none
    affect:
      audience: M:audience/voice-contributors
      elicits:
        - {feeling: belonging, when: adding a voice that is heard in a language}
      avoids: [bias against accents and languages]
    mattering:
      to-the-whole: Common Voice is a flagship Foundation initiative to mitigate bias in AI by democratising speech technology.
      weight: major
      inside:
        - who: ['O:role/Executive-Director']
          because: The Mobilize page calls Common Voice the largest people-powered voice dataset in the world.
          confidence: 0.5
      chosen:
        - who: ['M:audience/voice-contributors']
          because: Communities upload voices and help improve features, the Mobilize page says.
          confidence: 0.5
      prospective:
        - who: ['M:audience/voice-contributors']
          because: People who could add a voice or use the open datasets.
          confidence: 0.5

