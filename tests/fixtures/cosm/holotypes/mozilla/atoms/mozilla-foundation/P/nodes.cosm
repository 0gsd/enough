  - id: P:offering/grantmaking
    type: offering
    name: Grantmaking
    summary: 'Funding for changemakers building better: an Incubator and collaborative funds, with grants connected to a community of mentors, peers and funders. Over $35 million invested in a decade.'
    owner: O:role/Director-Global-Grants
    confidence: 0.8
    sources: ['https://www.mozillafoundation.org/en/what-we-do/grantmaking/', 'https://stateof.mozilla.org/pdf/Mozilla%20Foundation_Form_990_2024.pdf']
    visibility: public
    parts: ['P:service/incubator', 'P:service/collaborative-funds']
    economics:
      price: none
      cost:
        grants-paid-2024: 2336028
        unit: USD
    affect:
      audience: M:audience/grantees-and-fellows
      elicits:
        - {feeling: belonging, when: joining a cohort of builders}
        - {feeling: momentum, when: securing follow-on funding}
      avoids: [funding without community]
    mattering:
      to-the-whole: 'The Foundation''s central philanthropic act: scouting, funding, connecting and amplifying leaders and technologies.'
