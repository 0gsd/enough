cosm: 0.3

# The Foundation's products tree below the brand: three suites that mirror Imagine, Co-create and Mobilize on its site, eight offerings, their programs, and three internal functions. Retired items keep their place with a status and an end date.

nodes:
  - id: P:suite/imagine
    type: suite
    name: Imagine
    summary: 'Supporting the people and ideas that stretch what technology can be: artists, researchers and educators.'
    owner: O:role/VP-Imagination-and-Strategic-Growth
    confidence: 0.8
    sources: ['https://www.mozillafoundation.org/en/what-we-do/imagine/']
    visibility: public
    parts: ['P:offering/creative-futures', 'P:offering/nothing-personal', 'P:offering/mozilla-education']
    mattering:
      to-the-whole: The part of the Foundation that opens the future up so more people can take part, create boldly and learn together.
      weight: major
      inside:
        - who: ['O:role/VP-Imagination-and-Strategic-Growth']
          because: 'Imagination is named as the first step: to build a better internet, first imagine it.'
          confidence: 0.5

  - id: P:suite/co-create
    type: suite
    name: Co-create
    summary: 'Building good technology with the people it affects: data, grants and the Common Voice dataset.'
    owner: O:role/Executive-Director
    confidence: 0.8
    sources: ['https://www.mozillafoundation.org/en/what-we-do/co-create/', 'https://www.mozillafoundation.org/en/what-we-do/grantmaking/']
    visibility: public
    parts: ['P:offering/grantmaking', 'P:offering/common-voice']
    mattering:
      to-the-whole: Where the Foundation puts money and engineering behind alternatives to extractive technology.
      weight: critical
      inside:
        - who: ['O:role/Executive-Director', 'O:role/Director-Global-Grants']
          because: 'The grantmaking page: Mozilla Foundation funds the innovators building the alternatives a better future demands.'
          confidence: 0.5

  - id: P:suite/mobilize
    type: suite
    name: Mobilize
    summary: 'People-powered action: the festival, the fellowships and the campaigns.'
    owner: O:role/Executive-Director
    confidence: 0.8
    sources: ['https://www.mozillafoundation.org/en/what-we-do/mobilize/']
    visibility: public
    parts: ['P:offering/mozilla-festival', 'P:offering/fellowships', 'P:offering/campaigns']
    mattering:
      to-the-whole: Turns a community of technologists, artists and citizens into collective action.
      weight: major
      inside:
        - who: ['O:role/Director-Mozilla-Festival', 'O:role/Director-Communications']
          because: Community is what much of the Foundation's work is powered by.
          confidence: 0.5

  - id: P:offering/creative-futures
    type: offering
    name: Creative Futures
    summary: 'Programs that turn community imagination into open artifacts, prototypes and cultural tools: assemblies, residencies, grants and performing-arts programs.'
    owner: O:role/VP-Imagination-and-Strategic-Growth
    confidence: 0.7
    sources: ['https://www.mozillafoundation.org/en/what-we-do/imagine/', 'https://www.mozillafoundation.org/en/what-we-do/mobilize/']
    visibility: public
    parts: ['P:service/artists-make-technology', 'P:service/counterstructures-residencies', 'P:service/imaginative-intelligences', 'P:service/creative-media-awards']
    economics:
      price: none
    affect:
      audience: M:audience/creative-sector
      elicits:
        - {feeling: agency, when: a community imagines a technology and holds a working artifact}
      avoids: [technology as something done to the sector]
    mattering:
      to-the-whole: Anchors imagination as critical infrastructure for new technology.
      weight: major
      inside:
        - who: ['O:role/VP-Imagination-and-Strategic-Growth']
          because: The program's aim is to return agency to communities, including the funders that back them.
          confidence: 0.5
      chosen:
        - who: ['M:audience/creative-sector']
          because: The programs build open cultural tools and infrastructures that shape the internet, civic institutions and culture, the page says.
          confidence: 0.5
      prospective:
        - who: ['M:audience/creative-sector']
          because: The page says the programs help the arts and culture sector navigate technology shifts and build knowledge about opportunities like AI.
          confidence: 0.5

