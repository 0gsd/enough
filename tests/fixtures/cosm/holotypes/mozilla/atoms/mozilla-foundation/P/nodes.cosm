      inside:
        - who: ['O:role/Director-Global-Grants']
          because: It scouts, invests, connects and amplifies, in that order.
          confidence: 0.5
      chosen:
        - who: ['M:audience/grantees-and-fellows']
          because: Incubator participants secure follow-on funding and go on to real-world impact independent of the Foundation.
          confidence: 0.5
      prospective:
        - who: ['M:audience/grantees-and-fellows']
          because: Builders of environmental justice tools, AI bias research and digital rights work who need funding and networks.
          confidence: 0.5

