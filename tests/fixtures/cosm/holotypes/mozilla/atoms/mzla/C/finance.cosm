# C: MZLA's public figures. Contributions are rounded as Thunderbird states them.
nodes:
  - id: C:finance/fy2024
    type: finance
    name: MZLA, 2024
    summary: Total income $10.8 million and end-of-year assets $12.0 million. Contributions from users were $10.3 million (up 19%) from more than 335,000 donors in over 200 countries; the top ten countries, led by Germany and the United States, gave 83%. MZLA paid the Foundation $415 thousand in trademark licence fees.
    by: atom/mzla
    period: '2024'
    currency: USD
    basis: IRS Form 990 Schedule R of the Foundation (total income, end-of-year assets); donations from Thunderbird's State of the Bird
    figures:
      total-income: 10760074
      end-of-year-assets: 11983311
      user-contributions: 10300000
      trademark-licence-fees-paid: 415000
      donors: 335000
      full-time-staff-year-end: 43
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://stateof.mozilla.org/pdf/Mozilla%20Foundation_Form_990_2024.pdf', 'https://blog.thunderbird.net/2025/10/state-of-the-bird-2024-25/', 'https://stateof.mozilla.org/pdf/Mozilla%20Fdn%202024%20-%20AuditedFinancials.pdf'], confidence: 0.9, state: known}

