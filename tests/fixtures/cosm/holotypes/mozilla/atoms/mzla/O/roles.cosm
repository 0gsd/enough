# O: roles: the chief executive, the council and the twelve team functions the about page lists. Nobody is named.
nodes:
  - id: O:role/Chief-Executive
    type: role
    name: Chief Executive
    summary: The chief executive seat, titled CEO of Thunderbird on the leadership page.
    governs: ['P:thunderbird']
    visibility: public
    provenance: {mode: net-scan, sources: ['https://www.mozilla.org/en-US/about/leadership/'], confidence: 0.9, state: known}

