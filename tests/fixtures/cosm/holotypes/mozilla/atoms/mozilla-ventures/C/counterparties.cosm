# C: counterparties: the portfolio as a class, five portfolio companies named with their domains, and a partner.
nodes:
  - id: C:counterparty/ventures-portfolio
    type: counterparty
    name: The Mozilla Ventures portfolio
    summary: 'The class of early-stage companies the fund has backed: 40 listed on mozilla.vc/portfolio in October 2026; the 2024 report says it had invested in 45. A class stub for the template bond below.'
    kind: portfolio
    global-id:
      state: not-disclosed
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://mozilla.vc/portfolio', 'https://www.mozilla.org/en-US/foundation/annualreport/2024/article/financing-an-open-internet-mozillas-path-forward/'], confidence: 0.8, state: known}

