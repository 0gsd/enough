    presents: ['P:offering/mdn']
    counterparty: none
    status: active
    visibility: public
    owner: O:role/MDN-Team
    provenance: {mode: net-scan, sources: ['https://developer.mozilla.org/en-US/about'], confidence: 0.9, state: known}

  - id: R:surface/0din-site
