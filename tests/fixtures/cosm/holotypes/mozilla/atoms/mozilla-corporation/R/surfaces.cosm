# R: surfaces. The platform listings carry a counterparty.
nodes:
  - id: R:surface/firefox-site
    type: surface
    name: firefox.com
    summary: 'The Firefox home: downloads for every platform, Beta and Nightly, add-ons, release notes and the roadmap.'
    kind: website
    url: https://www.firefox.com/en-US/
    presents: ['P:offering/firefox', 'P:offering/firefox-enterprise']
    counterparty: none
    status: active
    visibility: public
    owner: O:role/Firefox-Product-Management
    provenance: {mode: net-scan, sources: ['https://www.firefox.com/en-US/'], confidence: 0.9, state: known}

  - id: R:surface/mozilla-site
    type: surface
    name: mozilla.org
    summary: 'The Mozilla site: products, advertising, legal terms, leadership and the family of organizations.'
    kind: website
    url: https://www.mozilla.org/en-US/products/
    presents: ['P:offering/mozilla-vpn', 'P:offering/mozilla-monitor', 'P:offering/mozilla-ads']
    counterparty: none
    status: active
    visibility: public
    owner: O:role/Chief-Executive-Officer
    provenance: {mode: net-scan, sources: ['https://www.mozilla.org/en-US/products/'], confidence: 0.9, state: known}

  - id: R:surface/relay-site
    type: surface
    name: relay.firefox.com
