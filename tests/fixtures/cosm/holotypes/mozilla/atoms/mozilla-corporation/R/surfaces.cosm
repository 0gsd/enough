    counterparty: none
    status: active
    visibility: public
    owner: O:role/Privacy-Services-Team
    provenance: {mode: net-scan, sources: ['https://relay.firefox.com/'], confidence: 0.9, state: known}

  - id: R:surface/mdn-site
    type: surface
    name: developer.mozilla.org
