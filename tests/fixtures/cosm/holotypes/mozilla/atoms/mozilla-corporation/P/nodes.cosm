cosm: 0.3

# The Corporation's tree: six suites (five live, one of retired products), eleven offerings and their units.

nodes:
  - id: P:suite/firefox
    type: suite
    name: Firefox
    summary: The browser on every platform, its enterprise edition, the Mozilla account, the add-ons marketplace and support.
    owner: O:role/Firefox-Product-Management
    confidence: 0.8
    sources: ['https://www.firefox.com/en-US/', 'https://www.mozilla.org/en-US/products/']
    visibility: public
    parts: ['P:offering/firefox', 'P:offering/firefox-enterprise', 'P:offering/mozilla-account', 'P:offering/firefox-add-ons']
    mattering:
      to-the-whole: Firefox earns the search royalties that were 73% of the group's revenue and support in 2024.
      weight: critical
      inside:
        - who: ['O:role/Firefox-Product-Management']
          because: Product management answers for the roadmap published at firefox.com/whatsnext.
          confidence: 0.5

  - id: P:offering/firefox
    type: offering
    name: Firefox
    summary: 'The browser: protection against more than 2,000 data trackers built in, tab groups, reader mode, picture-in-picture, optional AI features, on Windows, macOS, Linux, Android and iOS; open source and not owned by shareholders.'
    owner: O:role/Firefox-Product-Management
    confidence: 0.8
    sources: ['https://www.firefox.com/en-US/', 'https://www.mozilla.org/en-US/products/', 'https://blog.mozilla.org/en/firefox/firefox-roadmap-152/']
    visibility: public
    parts: ['P:product/firefox-desktop', 'P:product/firefox-android', 'P:product/firefox-ios', 'P:product/firefox-focus', 'P:service/firefox-release-channels', 'P:product/firefox-smart-window', 'P:service/firefox-support']
    flow:
      inputs:
        - {resource: search-royalty, from: 'C:counterparty/google', unit: USD/year}
      outputs:
        - {resource: browser, to: 'M:audience/firefox-users', unit: users/month}
    economics:
      price: none
      revenue: search royalties from partners, mainly; see C:contract/search-partnerships
    affect:
      audience: M:audience/firefox-users
      elicits:
        - {feeling: safety, when: opening a page with trackers blocked without setup}
        - {feeling: control, when: turning AI features off}
      avoids: [AI that cannot be turned off, setup before protection]
      tone: [plain]
    mattering:
      to-the-whole: 'The browser is the Corporation''s flagship: Mozilla''s product list leads with it and Firefox-related income was $658.5 million in 2024.'
      weight: critical
      inside:
        - who: ['O:role/Firefox-Product-Management']
          because: The roadmap is public and users give feedback on Mozilla Connect.
          confidence: 0.5
      chosen:
        - who: ['M:audience/firefox-users']
          because: More than 210 million people use it each month (Mozilla Advertising page, 2026).
          confidence: 0.5
      prospective:
        - who: ['M:audience/firefox-users']
          because: 'People on other browsers: the June 2026 roadmap adds PDF editing, tab groups on iOS and a free VPN on mobile.'
          confidence: 0.5

  - id: P:product/firefox-desktop
    type: product
    name: Firefox for desktop
    summary: Firefox on Windows, macOS and Linux; the Firefox 158 release notes are linked from the Mozilla site in October 2026.
    owner: O:role/Firefox-Engineering
    confidence: 0.8
    sources: ['https://www.firefox.com/en-US/']
    visibility: public
    flow:
      outputs:
        - {resource: browser, to: 'M:audience/firefox-users', unit: users/month}
    substrate:
      platforms:
        - S:codebase/firefox
        - S:system/firefox-ci
    mattering:
      to-the-whole: The desktop browser, on Windows, macOS and Linux.
      weight: critical
      inside:
        - who: ['O:role/Firefox-Engineering']
          because: Engineering builds it on the Gecko engine in the open.
          confidence: 0.5

  - id: P:product/firefox-android
    type: product
    name: Firefox for Android
    summary: Firefox on Google Play. Firefox 152 (June 2026) added tab groups on Android; built-in VPN and Power Saving Mode are on the roadmap for mobile.
    owner: O:role/Firefox-Product-Management
    confidence: 0.8
