  - id: P:offering/firefox-enterprise
    type: offering
    name: Firefox Enterprise
    summary: 'An on-premises, customer-controlled browser platform for regulated and security-sensitive organizations: centralized policy, native data-loss controls, AI tool controls, SIEM integration, Lockdown Mode and extension governance. Buyers contact sales; standard support is included and Professional Support is a paid upgrade.'
    owner: O:role/Firefox-Product-Management
    confidence: 0.8
    sources: ['https://www.firefox.com/en-US/browsers/enterprise/']
    visibility: public
    economics:
      price:
        model: negotiated
        channel: contact sales
        detail: {pending: price list; none published}
    affect:
      audience: M:audience/enterprise-it
      elicits:
        - {feeling: control, when: setting a policy for every browser in the organization}
        - {feeling: trust, when: getting a defined response from support}
      avoids: [loss of data control]
    mattering:
      to-the-whole: Mozilla's browser sold to regulated and security-sensitive organizations on a contact-sales basis, a revenue line other than search royalties.
      weight: major
      inside:
        - who: ['O:role/Firefox-Product-Management']
          because: The page says the browser is open source and built on Mozilla's own browser engine.
          confidence: 0.5
      chosen:
        - who: ['M:audience/enterprise-it']
          because: IT teams get centralized policy, native data-loss controls, AI tool controls and SIEM integration, per the page.
          confidence: 0.5
      prospective:
        - who: ['M:audience/enterprise-it']
          because: Regulated and security-sensitive organizations, the buyers the page names.
          confidence: 0.5

