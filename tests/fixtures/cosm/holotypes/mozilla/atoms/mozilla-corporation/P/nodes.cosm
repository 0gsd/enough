        model: freemium
        free-tier: 5 email masks, browser extension, email tracker removal
        premium: {pending: 'Premium prices: the page lists none and Premium is waitlist-only'}
    affect:
      audience: M:audience/privacy-subscribers
      elicits:
        - {feeling: relief, when: giving a mask instead of a real address}
    mattering:
      to-the-whole: Five email masks are free; Premium tiers add unlimited masks, a phone mask and a VPN bundle.
      weight: supporting
      inside:
        - who: ['O:role/Privacy-Services-Team']
          because: Relay signs in with the Mozilla account.
          confidence: 0.5
      chosen:
        - who: ['M:audience/privacy-subscribers']
          because: Relay protects a real email address to help control the inbox, per the products page.
          confidence: 0.5
      prospective:
        - who: ['M:audience/privacy-subscribers']
          because: People on the Premium waitlist.
          confidence: 0.5

