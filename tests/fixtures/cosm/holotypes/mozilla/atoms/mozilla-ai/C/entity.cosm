# C: the legal shell, its board and three events.
nodes:
  - id: C:entity/mzl-ai-pbc
    type: entity
    name: MZL.AI, PBC
    summary: California public benefit corporation (a C corporation for US tax) that builds Mozilla.ai's open-source AI products and infrastructure; launched in March 2023 with $30 million committed by the Foundation and still pre-revenue in the 2024 report. Headquartered at 1875 Mission Street, San Francisco, with a team distributed across nine countries.
    anchor: true
    form: corporation
    roles: [company, brand]
    jurisdiction: US-CA
    registered-office: 1875 Mission Street, San Francisco, CA 94103
    domains: [mozilla.ai]
    global-id: {ein: 35-2775450, domain: mozilla.ai}
    tax-status: C corporation (taxable); public benefit corporation
    fiscal-year: calendar
    since: 2023-03
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://stateof.mozilla.org/pdf/Mozilla%20Foundation_Form_990_2024.pdf', 'https://stateof.mozilla.org/pdf/Mozilla%20Fdn%202024%20-%20AuditedFinancials.pdf', 'https://www.mozilla.ai/', 'https://mozilla.ai/company/about-us', 'https://www.mozilla.org/en-US/foundation/annualreport/2024/article/financing-an-open-internet-mozillas-path-forward/'], confidence: 0.9, state: known}

