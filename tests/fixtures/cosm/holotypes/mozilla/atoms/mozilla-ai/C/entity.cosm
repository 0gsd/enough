    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://github.com/mozilla-ai'], confidence: 0.8, state: known}

  - id: C:event/otari-general-availability
    type: event
    name: Otari generally available
    summary: Mozilla.ai's llms.txt (updated 2026-10-14) labels Otari as general availability; a third-party directory dates its release to 2026-07-06, which no Mozilla page confirms.
    kind: launch
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: ['https://www.mozilla.ai/llms.txt'], confidence: 0.7, state: known}
