    status: active
    visibility: public
    owner: O:role/board-of-trustees
    provenance: {mode: net-scan, sources: ["https://foundation.wikimedia.org/wiki/Bylaws", "https://meta.wikimedia.org/wiki/Wikimedia_Foundation/Board_of_Trustees"], confidence: 0.85, state: known}
    covered-by: none
    twin: none

