  - id: M:account/other-partners
    type: account
    name: Other named partners and customers
    summary: Ecosia, Pleias and ProRata (new over the past year per the Foundation's January 2026 post), Nomic and Reef Media (Enterprise blog) and Databricks and Firecrawl (Enterprise site); some may use the free tier.
    counterparty: C:counterparty/enterprise-other-partners
    channel: M:channel/enterprise-api
    contract: C:contract/enterprise-agreements
    pricebook: M:pricebook/enterprise
    arr-band: {pending: "which of them pay, and how much"}
