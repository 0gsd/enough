# R — surfaces: the Endowment's website and the governance pages it keeps on the Foundation's wiki. The annual report and financial documents hang off the website.
nodes:
  - id: R:surface/endowment-site
    type: surface
    name: wikimediaendowment.org
    summary: "The Endowment's own website: about, impact, giving, leadership, annual reports, audits and Forms 990."
    kind: website
    url: https://wikimediaendowment.org
    hosted-on: S:system/endowment-site
    presents: [P:offering/permanent-fund, P:offering/project-grants, P:offering/legacy-giving]
    counterparty: none
    status: active
    visibility: public
    owner: O:role/president
    provenance: {mode: net-scan, sources: ["https://wikimediaendowment.org/"], confidence: 0.9, state: known}

