  substrate:
    roles-required: [{role: O:role/Chief-Learning-Officer, load: large}]
    budget: "$12.1M of program expense in the year to June 2025 (Form 990 Part III, line 4b)"
  mattering:
    to-the-whole: "Content is what a learner meets first; its quality decides whether the practice is worth doing."
    weight: critical
    inside:
      - who: [O:role/Chief-Learning-Officer]
        because: "The goal is the world's best learning resource for the K-12 classroom and for any independent learner, and the work is never finished."
        confidence: 0.5

