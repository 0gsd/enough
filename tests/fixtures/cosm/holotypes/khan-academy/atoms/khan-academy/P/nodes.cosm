# nodes.cosm: the product tree under the brand: four suites, eleven offerings, five functions and the units below them.
# Read from the nonprofit's own pages and its Form 990 (research mode, 2026-10-18); mattering is the modeller's reading unless a source is cited.
nodes:

- id: P:suite/free-learning
  type: suite
  name: The free learning platform
  summary: "Courses, practice and test prep for learners, with assignment and tracking tools for teachers, all free: more than 840 courses for K-12 and early college on the nonprofit's own count."
  owner: O:role/Chief-Learning-Officer
  confidence: 0.9
  sources: [ka-about, ka-home, ka-test-prep]
  visibility: public
  parts: [P:offering/courses-and-practice, P:offering/test-prep, P:offering/teacher-tools]
  mattering:
    to-the-whole: "This is what the name means to most people; the AI tutor, the district program and the apps are built on its content and its practice."
    weight: critical
    inside:
      - who: [O:role/Chief-Learning-Officer, O:role/Chief-Technology-Officer]
        because: "The library and its practice engine are the part that has to keep working for tens of millions of people at no charge."
        confidence: 0.5

- id: P:suite/khanmigo
  type: suite
  name: Khanmigo
  summary: "The AI tutor for learners and parents and the AI teaching assistant for teachers, with the Writing Coach; introduced in March 2023."
  owner: O:role/Chief-Learning-Officer
  pending: "which role runs Khanmigo as a product: learning, engineering or a separate product role?"
  confidence: 0.8
  sources: [khanmigo-home, journal-khanmigo-2023, ka-about]
  visibility: public
  parts: [P:offering/khanmigo-teachers, P:offering/khanmigo-families, P:offering/writing-coach]
  mattering:
    to-the-whole: "The nonprofit's answer to generative AI: a tutor built to guide, funded partly by subscriptions and partly by partner support."
    weight: major
    inside:
      - who: [O:role/Chief-Learning-Officer, O:role/Chief-Technology-Officer]
        because: "Every interaction costs money, so the team has to show that guided AI help leads to learners who then solve the next problem alone."
        confidence: 0.5

- id: P:suite/districts
  type: suite
  name: Khan Academy Districts
  summary: "The district program, launched in 2019 and rebuilt in 2025-26 with Khanmigo built into the platform: partnership services, insights for leaders, add-ons such as Learning Paths."
  owner: O:role/Chief-Executive
  pending: "which role runs the districts business day to day? No public page names it"
  confidence: 0.8
  sources: [ka-districts, blog-districts-2026]
  visibility: public
  parts: [P:offering/districts-partnership, P:offering/learning-paths]
  mattering:
    to-the-whole: "The part of the line sold to institutions at a price; the return books $22.2 million of program service revenue in the year to June 2025 and does not say how much is districts, Khanmigo subscriptions or other fees."
    weight: major
    inside:
      - who: [O:role/Chief-Executive, O:role/Chief-External-Relations-Officer]
        because: "It is where free classroom use turns into a measured, school-wide habit, and where a nonprofit finds out whether its claims hold in real schools."
        confidence: 0.5

- id: P:suite/early-learning
  type: suite
  name: Khan Academy Kids
  summary: "The early-learning line: a free app for children aged 2 to 8 and a school version with teacher tools, built in the line of the Duck Duck Moose apps."
  owner: O:role/Kids-Lead
  confidence: 0.9
  sources: [ka-kids, edweek-kids-2018, techcrunch-ddm-2016]
  visibility: public
  parts: [P:offering/khan-kids, P:offering/kids-for-schools]
  mattering:
    to-the-whole: "It carries the mission down to age 2 and gives the nonprofit its youngest audience, reached through the parents who download it."
    weight: major
    inside:
      - who: [O:role/Kids-Lead]
        because: "A small team making a free product for the youngest learners, judged by parents and classroom teachers every day."
        confidence: 0.5

- id: P:offering/courses-and-practice
  type: offering
  name: Courses and practice
  summary: "Free courses with videos, articles and mastery-based practice for K-12 and early college: math at every level, English language arts, science, social studies, computing, economics and life skills, plus partner courses. About 800 active courses on the Form 990 count at 30 June 2025; more than 840 on the About page."
  owner: O:role/Chief-Learning-Officer
  confidence: 0.9
  sources: [ka-about, ka-home, f990-2025, ka-partner-content]
  visibility: public
  flow:
    inputs:
      - {resource: course-content, from: P:function/content-creation, unit: courses}
      - {resource: platform-delivery, from: P:product/learning-platform, unit: sessions}
      - {resource: translations, from: P:function/localization, unit: languages}
    outputs:
      - {resource: practice-and-lessons, to: M:audience/students, unit: active learners/month, rate: 8500000}
      - {resource: practice-and-lessons, to: M:audience/teachers, unit: assignments}
      - {resource: math-content, to: P:offering/learning-paths, unit: courses}
    schedule: continuous
  substrate:
    platforms: [S:system/learning-platform]
    depends-on: [P:function/content-creation, P:product/learning-platform]
  economics:
    price: {model: free}
    cost: {pending: "cost of the library per course or per active learner; the return gives only the program totals"}
    margin: none
  vocabulary:
    terms:
      - {term: skill, maps-to: P:khan-academy/skill}
      - {term: mastery, maps-to: P:khan-academy/mastery}
  affect:
    audience: M:audience/students
    elicits:
      - {feeling: confidence, intensity: 0.7, when: "a skill is mastered"}
      - {feeling: progress, intensity: 0.7, when: "the skill tally grows"}
    avoids: ["being stuck without help", "feeling behind"]
    probes: [motivation, satisfaction]
    tone: [encouraging, plain, patient]
  mattering:
    to-the-whole: "Without it there is no nonprofit: the free library is the product every other offering is built on or sold beside."
    weight: critical
    inside:
      - who: [O:role/Chief-Learning-Officer, O:role/Chief-Technology-Officer]
        because: "Tens of millions of people learn here each year with nothing else to fall back on; a broken exercise is somebody's homework."
        confidence: 0.5
    chosen:
      - who: [M:audience/students, M:audience/teachers]
        because: "Standards-aligned practice at the learner's own level, free and available at any hour, replaces a paid tutor or a worksheet that cannot respond."
        stakes: "Practice that stops when the lesson ends."
        confidence: 0.6
    prospective:
      - who: [M:audience/students, M:audience/families]
        because: "Families abroad and in under-served US schools gain a way to catch up in their own language."
        barrier: "Connectivity, translation coverage and not knowing it is free."
        confidence: 0.5

- id: P:offering/test-prep
  type: offering
  name: Test prep
  summary: "Free preparation for the SAT (math, reading and writing, and get-ready courses) built with the College Board, plus listed courses for the MCAT, the LSAT and the OECD's PISA practice program."
  owner: O:role/Chief-Learning-Officer
  confidence: 0.8
  sources: [ka-test-prep, collegeboard-sat, ka-districts]
  visibility: public
  flow:
    inputs:
      - {resource: official-practice-content, from: C:counterparty/college-board, unit: tests}
      - {resource: test-prep-content, from: P:function/content-creation, unit: courses}
      - {resource: platform-delivery, from: P:product/learning-platform, unit: sessions}
    outputs:
      - {resource: test-prep, to: M:audience/students, unit: learners}
    schedule: continuous
  substrate:
    platforms: [S:system/learning-platform]
    depends-on: [C:counterparty/college-board]
  rules:
    - must: "O:role/Chief-of-Staff keep Official Digital SAT Prep free to students"
      source: collegeboard-sat
      confidence: 0.8
  economics:
    price: {model: free}
    cost: {pending: "cost of the SAT program and of the other test-prep courses"}
    margin: none
  affect:
    audience: M:audience/students
    elicits:
      - {feeling: readiness, intensity: 0.7, when: "a full-length practice test is reviewed against lessons"}
    avoids: ["test anxiety from surprises", "paying for prep"]
    probes: [anticipation, motivation]
    tone: [calm, exact]
  mattering:
    to-the-whole: "The bridge to high-stakes tests that many learners otherwise buy courses for; it also gives the nonprofit its standing with test makers and districts."
    weight: major
    inside:
      - who: [O:role/Chief-Learning-Officer, O:role/Chief-of-Staff]
        because: "A long partnership with the College Board is a trust the whole team must keep earning with each test change."
        confidence: 0.5
    chosen:
      - who: [M:audience/students]
        because: "A student can take a full practice test in the test's own app and then work the missed skills here, for nothing."
        stakes: "Paying for a prep course, or going in blind."
        confidence: 0.6
    prospective:
      - who: [M:audience/districts, M:audience/families]
        because: "Districts see test prep as a reason to roster a whole grade; families see a free alternative to a paid course."
        barrier: "Students who start too close to the test date."
        confidence: 0.5

- id: P:offering/teacher-tools
  type: offering
  name: Khan for Educators and classroom tools
  summary: "Free tools for teachers: assign practice, track progress, plan with standards-aligned unit guides (for example for Texas and the Next Generation Science Standards) and sign up with a free teacher account."
  owner: O:role/Chief-Learning-Officer
  confidence: 0.8
  sources: [ka-home, ka-about, ka-partner-content]
  visibility: public
  flow:
    inputs:
      - {resource: platform-delivery, from: P:product/learning-platform, unit: sessions}
    outputs:
      - {resource: classroom-tools, to: M:audience/teachers, unit: teacher accounts}
    schedule: continuous
  substrate:
    platforms: [S:system/learning-platform]
    depends-on: [P:product/learning-platform]
  economics:
    price: {model: free}
    cost: {pending: "cost of the teacher tools; donor support keeps them free"}
    margin: none
  affect:
    audience: M:audience/teachers
    elicits:
      - {feeling: control, intensity: 0.6, when: "an assignment is set and progress is visible"}
      - {feeling: relief, intensity: 0.5, when: "planning takes minutes"}
    avoids: ["extra paperwork", "data that cannot be trusted"]
    probes: [satisfaction]
    tone: [practical, plain]
  mattering:
    to-the-whole: "Teachers are a main route by which the platform reaches students in classrooms; free teacher tools are the on-ramp to the district program."
    weight: major
    inside:
      - who: [O:role/Chief-Learning-Officer]
        because: "Teachers are the most direct judges of whether the practice fits a classroom."
        confidence: 0.5
    chosen:
      - who: [M:audience/teachers]
        because: "A teacher can set nightly practice and see who needs help without buying software or asking a district."
        stakes: "Grading by hand, and no view of who is stuck."
        confidence: 0.6
    prospective:
      - who: [M:audience/districts]
        because: "Leaders who see teachers already using it have a reason to make use consistent across schools."
        barrier: "Wanting data and training that free teacher accounts do not provide."
        confidence: 0.5

- id: P:offering/khanmigo-teachers
  type: offering
  name: Khanmigo for teachers
  summary: "An AI teaching assistant, free to sign up for: lesson plans tied to the content library, summaries of recent student work, learning objectives, rubrics, exit tickets, quiz questions, differentiation and groupings. Free to US teachers since May 2024 with Microsoft's donated infrastructure."
  owner: O:role/Chief-Learning-Officer
  confidence: 0.8
  sources: [khanmigo-home, blog-microsoft, journal-khanmigo-2023]
  visibility: public
  flow:
    inputs:
      - {resource: ai-assistance, from: P:product/khanmigo-ai, unit: requests}
      - {resource: donated-infrastructure, from: C:counterparty/microsoft, unit: compute}
    outputs:
      - {resource: planning-tools, to: M:audience/teachers, unit: teacher accounts}
    schedule: on-demand
  substrate:
    platforms: [S:system/khanmigo-ai]
    vendors: [S:vendor/microsoft]
    depends-on: [P:product/khanmigo-ai, S:vendor/microsoft]
  rules:
    - must: "all-roles keep teacher and student data private and secure when Khanmigo is used"
      source: khanmigo-home
      confidence: 0.7
  economics:
    price: {model: free}
    cost: {model: usage, band: {pending: "compute cost per teacher; Microsoft donates infrastructure"}}
    margin: none
  affect:
    audience: M:audience/teachers
    elicits:
      - {feeling: relief, intensity: 0.7, when: "an hour of planning takes fifteen minutes"}
    avoids: ["generic output", "student data leaving the classroom"]
    probes: [satisfaction]
    tone: [practical, plain]
  mattering:
    to-the-whole: "It carries the nonprofit's AI work into the classroom for free, where it can be tried by the people best placed to judge it."
    weight: major
    inside:
      - who: [O:role/Chief-Learning-Officer, O:role/Chief-of-Staff]
        because: "Free access rests on a donor in kind; the partnership has to be renewed and the cost kept in view."
        confidence: 0.5
    chosen:
      - who: [M:audience/teachers]
        because: "Planning, rubrics and quiz questions in minutes, tied to the content they already assign, at no cost to them or their school."
        stakes: "Evenings spent on paperwork."
        confidence: 0.6
    prospective:
      - who: [M:audience/districts]
        because: "Districts see AI used safely by their own teachers before paying for student access."
        barrier: "Student access exists only through a school or district implementation."
        confidence: 0.5

- id: P:offering/khanmigo-families
  type: offering
  name: Khanmigo for learners and parents
  summary: "An AI tutor that guides a learner to the answer instead of giving it, covering subjects from algebra to essay writing and coding practice; $4 a month or $44 a year. A parent account activates it for up to 10 children, with chat history and safety alerts. For US residents with a US billing address."
  owner: O:role/Chief-Learning-Officer
  confidence: 0.9
  sources: [khanmigo-learners, khanmigo-parents, khanmigo-home]
  visibility: public
  flow:
    inputs:
      - {resource: ai-tutoring, from: P:product/khanmigo-ai, unit: conversations}
      - {resource: subscriptions, from: M:audience/families, unit: USD/month, rate: {pending: "paying accounts; the nonprofit does not publish a subscriber count"}}
    outputs:
      - {resource: tutoring, to: M:audience/families, unit: conversations}
      - {resource: tutoring, to: M:audience/students, unit: conversations}
    schedule: on-demand
  substrate:
    platforms: [S:system/khanmigo-ai]
    depends-on: [P:product/khanmigo-ai]
  rules:
    - must: "all-roles limit Khanmigo subscriptions for learners and parents to US residents with a US billing address"
      source: khanmigo-home
      confidence: 0.8
    - must: "all-roles require parental consent or a school or district implementation before a learner under 18 uses Khanmigo"
      source: blog-microsoft
      confidence: 0.8
  economics:
    price: {model: flat, value: 4, unit: USD/month}
    cost: {model: usage, band: {pending: "inference cost per conversation; the page says every interaction has a cost"}}
    margin: {pending: "whether subscriptions cover the cost of serving them"}
  vocabulary:
    terms:
      - {term: Khanmigo, maps-to: P:khan-academy/Khanmigo}
  affect:
    audience: M:audience/families
    elicits:
      - {feeling: reassurance, intensity: 0.7, when: "a parent sees the child's chat history and safety alerts"}
      - {feeling: curiosity, intensity: 0.6, when: "the tutor asks a question instead of answering"}
    avoids: ["an answer machine", "unmonitored AI chat for children"]
    probes: [satisfaction, motivation]
    tone: [patient, curious, plain]
  mattering:
    to-the-whole: "The paid side of the AI line: payment covers part of its cost and shows whether families will pay for guided help."
    weight: major
    inside:
      - who: [O:role/Chief-Learning-Officer, O:role/Chief-Technology-Officer]
        because: "Proof that an AI tutor can be built to keep learners thinking, and kept safe, is the nonprofit's claim to be different from a general chatbot."
        confidence: 0.5
    chosen:
      - who: [M:audience/families, M:audience/students]
        because: "Help with homework at any hour that makes the child do the thinking, with the parent able to see what was asked."
        stakes: "A chatbot that gives the answer, or no help at all."
        confidence: 0.6
    prospective:
      - who: [M:audience/families]
        because: "Families outside the United States cannot subscribe at all today; those inside may not know it exists."
        barrier: "US-only sales, price against free alternatives, and doubts about AI for children."
        confidence: 0.5

- id: P:offering/writing-coach
  type: offering
  name: Writing Coach
  summary: "An AI writing practice and instruction tool for students in grades 5 to 12, with step-by-step guidance for learners and insights for teachers; free to sign up and also offered to districts. Gemini models were announced for it in February 2026, and a Reading Coach is expected later in 2026."
  owner: O:role/Chief-Learning-Officer
  confidence: 0.7
  sources: [khanmigo-home, ka-districts, journal-google-2026]
  visibility: public
  flow:
    inputs:
      - {resource: ai-feedback, from: P:product/khanmigo-ai, unit: drafts}
      - {resource: model-access, from: C:counterparty/google, unit: requests}
    outputs:
      - {resource: writing-practice, to: M:audience/students, unit: drafts}
      - {resource: writing-insights, to: M:audience/teachers, unit: reports}
    schedule: on-demand
  substrate:
    platforms: [S:system/khanmigo-ai]
    vendors: [S:vendor/google]
    depends-on: [P:product/khanmigo-ai, S:vendor/google]
  economics:
    price: {model: free}
    cost: {model: usage, band: {pending: "model cost per draft; Google.org supports the Gemini work"}}
    margin: none
  affect:
    audience: M:audience/students
    elicits:
      - {feeling: confidence, intensity: 0.6, when: "feedback names what to fix next"}
    avoids: ["an essay written for the student", "grades without reasons"]
    probes: [motivation]
    tone: [encouraging, exact]
  mattering:
    to-the-whole: "Writing is a skill where an AI tutor can be misused to do the work for the student; a coach that teaches it is a proof point for the whole AI line."
    weight: supporting
    inside:
      - who: [O:role/Chief-Learning-Officer]
        because: "It is offered free to learners as well as teachers, so it is where the nonprofit sees whether guidance beats shortcuts."
        confidence: 0.4
    chosen:
      - who: [M:audience/students, M:audience/teachers]
        because: "Students get feedback at every draft and teachers see where the writing is weak, without grading every draft by hand."
        stakes: "One round of comments a week, too late to use."
        confidence: 0.5
    prospective:
      - who: [M:audience/districts]
        because: "Writing is an area where districts look for instruction support beyond math."
        barrier: "Concern that students will let the tool write for them."
        confidence: 0.4

- id: P:offering/districts-partnership
  type: offering
  name: Khan Academy Districts partnership
  summary: "A paid partnership for school districts: rostering, tailored implementation and training, ongoing strategic support, insight across schools, Khanmigo built into practice, the Writing Coach, SAT support and assessments for grades 3 to 12. More than 600 partner districts by the page's count; the rebuilt experience reaches every partner from the 2026-27 school year."
  owner: O:role/Chief-Executive
  pending: "which role runs district partnerships day to day, and what a partnership costs: the site says to talk to the team"
  confidence: 0.8
  sources: [ka-districts, blog-districts-2026, ka-home, ka-about]
  visibility: public
  parts: [P:service/district-implementation]
  flow:
    inputs:
      - {resource: partnership-fees, from: M:audience/districts, unit: USD/year, rate: {pending: "revenue from district partnerships; not split out in the Form 990"}}
      - {resource: platform-access, from: P:product/learning-platform, unit: student accounts}
      - {resource: ai-tutoring, from: P:product/khanmigo-ai, unit: conversations}
      - {resource: partner-leads, from: P:function/awareness-and-adoption, unit: districts}
    outputs:
      - {resource: implementation-and-insights, to: M:audience/districts, unit: districts}
      - {resource: practice-and-tutoring, to: M:audience/students, unit: student accounts}
    schedule: continuous
  substrate:
    platforms: [S:system/learning-platform, S:system/khanmigo-ai]
    depends-on: [P:product/learning-platform, P:product/khanmigo-ai, P:function/awareness-and-adoption]
    roles-required: [{role: O:role/Chief-Executive, load: medium}]
  economics:
    price: {pending: "district prices are quoted on request; the site publishes none"}
    cost: {pending: "cost of implementation staff and support per district"}
    margin: {pending: "whether district fees cover their own service cost"}
  affect:
    audience: M:audience/districts
    elicits:
      - {feeling: confidence, intensity: 0.7, when: "leaders see progress across every school"}
      - {feeling: momentum, intensity: 0.6, when: "students keep practising without being pushed"}
    avoids: ["tools that teachers do not use", "data that cannot be compared across schools"]
    probes: [anticipation, reward]
    tone: [practical, evidence-led]
  mattering:
    to-the-whole: "It turns free teacher use into a measured school-wide habit, and its fees help pay for the free tools everyone else uses."
    weight: major
    inside:
      - who: [O:role/Chief-Executive, O:role/Chief-External-Relations-Officer]
        because: "Partner districts are where the nonprofit proves its claims in real classrooms, one implementation at a time."
        confidence: 0.5
    chosen:
      - who: [M:audience/districts]
        because: "Rostering, training and a view of progress across every school, for a tool teachers already use."
        stakes: "Uneven adoption and no data to show a board."
        confidence: 0.6
    prospective:
      - who: [M:audience/districts]
        because: "Districts not yet partners can already see teachers using the free product and a state example of free statewide access."
        barrier: "No public price and the cost of changing a district's tools."
        confidence: 0.5

- id: P:offering/learning-paths
  type: offering
  name: Learning Paths informed by MAP Growth
  summary: "An add-on to a districts partnership that turns each student's MAP Growth scores into a personalised path of Khan Academy math, from grade 3 to Geometry. Requires Clever rostering for both products and at least 250 licences; sold by the nonprofit, with NWEA as a partner."
  owner: O:role/Chief-Executive
  pending: "which role owns this add-on, and what a licence costs"
  confidence: 0.8
  sources: [blog-learning-paths, blog-map-transition]
  visibility: public
  flow:
    inputs:
      - {resource: math-content, from: P:offering/courses-and-practice, unit: courses}
      - {resource: assessment-scores, from: C:counterparty/nwea, unit: students}
    outputs:
      - {resource: personalised-paths, to: M:audience/districts, unit: licences}
      - {resource: personalised-paths, to: M:audience/students, unit: students}
    schedule: continuous
  substrate:
    depends-on: [P:offering/courses-and-practice, C:counterparty/nwea]
  rules:
    - must: "all-roles sell Learning Paths only as an add-on to a Khan Academy Districts partnership"
      source: blog-learning-paths
      confidence: 0.8
    - must: "all-roles require Clever rostering for both Khan Academy Districts and MAP Growth before a district uses Learning Paths"
      source: blog-map-transition
      confidence: 0.8
  economics:
    price: {pending: "price per licence; the blog posts say to contact the districts team"}
    cost: {pending: "cost of serving a licence"}
    margin: {pending: "margin on the add-on"}
  affect:
    audience: M:audience/districts
    elicits:
      - {feeling: confidence, intensity: 0.6, when: "a path follows a student's own test results"}
    avoids: ["generic practice assignments", "manual goal setting"]
    probes: [satisfaction]
    tone: [practical, exact]
  mattering:
    to-the-whole: "The oldest institutional product (2019 as MAP Accelerator) and proof that the platform can plug into a district's own assessment data."
    weight: supporting
    inside:
      - who: [O:role/Chief-Executive]
        because: "It shows the platform working alongside a test maker's data rather than replacing it."
        confidence: 0.4
    chosen:
      - who: [M:audience/districts]
        because: "Each student's practice follows the latest test scores with a click, and teachers can adjust the goals."
        stakes: "Hand-built intervention lists."
        confidence: 0.6
    prospective:
      - who: [M:audience/districts]
        because: "Districts already on the assessment and on Clever are the natural buyers."
        barrier: "A 250-licence minimum and the sales handoff from NWEA to the nonprofit."
        confidence: 0.5

- id: P:offering/khan-kids
  type: offering
  name: Khan Academy Kids app
  summary: "A free app for children aged 2 to 8 covering early literacy, reading, writing, language and math through games and story-based lessons, guided by five characters; made with learning experts at Stanford and aligned to the Head Start framework and Common Core. On the App Store, Google Play and the Amazon Appstore. Launched in July 2018."
  owner: O:role/Kids-Lead
  confidence: 0.9
  sources: [ka-kids, ka-downloads, edweek-kids-2018]
  visibility: public
  parts: [P:product/kids-app]
  flow:
    inputs:
      - {resource: early-learning-content, from: P:function/content-creation, unit: activities}
    outputs:
      - {resource: early-learning, to: M:audience/early-learners, unit: children}
      - {resource: early-learning, to: M:audience/families, unit: households}
      - {resource: app-and-lessons, to: P:offering/kids-for-schools, unit: activities}
    schedule: continuous
  substrate:
