    atom: none
    global-id: {domain: standtogether.org}
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: [standtogether], confidence: 0.8, state: known}

  - id: C:counterparty/microsoft
    type: counterparty
    name: Microsoft
    summary: "Donated cloud infrastructure so that Khanmigo for Teachers is free to US teachers (announced May 2024); also exploring small language models for math tutoring."
    kind: partner
    atom: none
    global-id: {domain: microsoft.com}
    status: active
    visibility: public
    provenance: {mode: net-scan, sources: [blog-microsoft], confidence: 0.8, state: known}

  - id: C:counterparty/google
    type: counterparty
    name: Google
    summary: "Google.org grant and fellowship and access to Gemini models for new Khanmigo and Writing Coach tools (2026); also the operator of the Google Play store that carries the Android apps; a founding partner on the supporters page."
    kind: platform
