# S — vendors: the outside firms behind the AI service and the apps. Each resolves to one C:counterparty (rule 10).
nodes:
  - id: S:vendor/openai
    type: vendor
    name: OpenAI
    summary: "Maker of the GPT-4 model Khanmigo was launched on; no negotiated contract is public."
    counterparty: C:counterparty/openai
    contract: none
    status: active
    visibility: public
    owner: O:role/Chief-Technology-Officer
    provenance: {mode: net-scan, sources: [journal-khanmigo-2023, khanmigo-learners], confidence: 0.8, state: known}

  - id: S:vendor/google
    type: vendor
    name: Google
    summary: "Provides the Gemini models and engineering support behind the 2026 Khanmigo and Writing Coach tools, under a Google.org grant and fellowship."
    counterparty: C:counterparty/google
    contract: C:contract/google-org
    status: active
    visibility: public
    owner: O:role/Chief-Technology-Officer
    provenance: {mode: net-scan, sources: [blog-google-org, journal-google-2026], confidence: 0.8, state: known}

  - id: S:vendor/microsoft
    type: vendor
    name: Microsoft
    summary: "Donates the cloud infrastructure that lets Khanmigo for Teachers be free to US teachers."
    counterparty: C:counterparty/microsoft
    contract: C:contract/microsoft
    status: active
    visibility: public
    owner: O:role/Chief-Technology-Officer
    provenance: {mode: net-scan, sources: [blog-microsoft], confidence: 0.8, state: known}
