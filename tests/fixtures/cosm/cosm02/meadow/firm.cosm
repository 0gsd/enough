cosm: 0.2

# Meadow Software — the spec's running example, complete. Fictional, so every field can be filled and
# the model can reach equilibrium; use it to see what "done" looks like and to try the deck and pack.

firm:
  id: meadow
  name: Meadow Software
  kind: company
  summary: Bookkeeping for small restaurants; daily reconciled books and payroll with tip-out explained line by line.
  since: 2019-03-01
  legal-anchor: "Meadow Software Inc., Portland OR; Delaware law"
  owner: role/Founder
  confidence: 0.9
  sources: [session-1, session-2]
  parts: [suite/books, offering/payroll]
  rules:
    - must-not: "all-roles store card numbers at rest"
      source: PCI-DSS
      scope: descendants
    - must: "role/Support-Lead answer every ticket within 1 business day"
      else: "ticket escalates to role/Founder"
      source: local
      scope: descendants
  principles:
    purpose: "Give small restaurants a true picture of their money every morning."
    priorities: ["accuracy over speed", "clarity over features", "customer data stays theirs"]
    value:
      - {to: ext/restaurants, proposition: "books you can trust by 7am without hiring a bookkeeper"}
      - {to: ext/accountants, proposition: "clean, categorised, reconciled exports at year end"}
    quality:
      - {goal: "every day closes", measure: "share of customer-days closed by 07:00 local"}
    decides: ["pricing", "which banks to support next"]
  vocabulary:
    terms:
      - {term: close, means: "Locking a period so no entry can change."}
      - {term: tip-out, means: "Redistribution of pooled tips to staff by the house rule."}
      - {term: morning summary, means: "The one-page daily statement a customer opens at 7am."}
    assumes: ["customers bank with an institution that offers a feed or a CSV export"]
    boundary: ["Meadow does not file taxes and does not advise on them"]
  mattering:
    inside:
      - who: [role/Founder, role/Support-Lead, role/Payroll-Owner]
        because: "The team came from restaurants and bookkeeping; the product is the job they wish they'd had tools for."
        stakes: "Livelihood, and the pride of being the one piece of software a restaurant owner says they trust."
    chosen:
      - who: [ext/restaurants]
        because: "An owner who knows the true cash position every morning sleeps, orders, and staffs differently."
        stakes: "Back to spreadsheets at midnight and a bookkeeper they can't afford."
      - who: [ext/accountants]
        because: "A clean ledger at year end is a week of their life returned."
        stakes: "Reconstructing a year from receipts."
    prospective:
      - who: [ext/restaurants]
        because: "Every independent restaurant has this problem; most have never seen it solved for their size."
        barrier: "Switching books mid-year feels dangerous; the first import has to be flawless."

externals:
  - {id: ext/banks, kind: vendor, note: "Feed providers for ~120 institutions"}
  - {id: ext/restaurants, kind: market, note: "Independent restaurants, 1–4 locations, in the US"}
  - {id: ext/accountants, kind: market, note: "The customer's outside accountant, who receives exports"}

roles:
  - id: role/Founder
    duties: ["set priorities", "approve changes to the close procedure"]
    decides: ["pricing", "bank support roadmap"]
    governs: [meadow, suite/books, offering/ledger, function/ingest]
  - id: role/Support-Lead
    duties: ["answer tickets", "run the morning health check"]
    decides: ["refund of a month on a missed close"]
    governs: [service/reconcile]
    escalates-to: role/Founder
  - id: role/Payroll-Owner
    duties: ["run payroll on schedule", "approve tip-out rules"]
    decides: ["pay-period boundaries", "rounding policy"]
    governs: [offering/payroll, service/tip-out]
    escalates-to: role/Founder
    variance: {execution: 0.35, cadence-drift: "±3 days", note: "approvals cluster at period end"}
  - id: role/Engineer
    pool: true
    duties: ["keep the feeds flowing", "ship the importer"]
    escalates-to: role/Founder

contracts:
  - {id: c/banks, between: [meadow, ext/banks], terms: "per-connection monthly fee; 99.5% feed availability", since: 2019-06}
