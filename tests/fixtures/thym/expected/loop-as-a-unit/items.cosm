- id: P:program/loop-as-a-unit
  type: program
  name: loop-as-a-unit
  summary: 'Every service the house sells, marked as the house says it and then as what it does now, one pass at
    a time: under thym 1 the loop''s body runs member by member as a unit.'
  why: 'every service the house sells, marked as the house says it and then as what it does now, one pass at a time:
    under thym 1 the loop''s body runs member by member as a unit.'
  must: []
  decided: []
  takes:
  - name: h
    type: volume
  gives:
  - name: i
    type: volume
  lines: 3-17
  order: 1
  body: |
    program loop-as-a-unit
      why: every service the house sells, marked as the house says it and then as what it does now, one pass
           at a time: under thym 1 the loop's body runs member by member as a unit.

      takes h: volume                  -- the holotype
      gives i: volume                  -- an isotype

      for each o in h where kind is service
        let s = mark o as stated       -- read later in the same pass, as written
        if s has name then
          emit mark s as verified
        end
      end
      give project h as isotype
    end
  steps:
  - P:step/loop-as-a-unit.1
  - P:step/loop-as-a-unit.5
  provenance:
    mode: derived
