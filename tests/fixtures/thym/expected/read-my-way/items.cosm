nodes:
  - id: C:context/on-the-train
    type: context
    name: on-the-train
    summary: "Five minutes on a phone, standing."
    why: "five minutes on a phone, standing."
    medium: phone
    hurry: true
    words: 300
    lines: "3-9"
    order: 1
    body: |+
      context on-the-train
        why: five minutes on a phone, standing.

        medium "phone"
        hurry true
        words 300
      end

    provenance: {mode: derived, sources: ["read-my-way.thym#L3-L9"], confidence: 1}

  - id: P:program/read-my-way
    type: program
    name: read-my-way
    summary: "A package is read on the reader's terms: in a hurry, the short way in; otherwise an entailment in the reader's own morph, for this occasion."
    why: "a package is read on the reader's terms: in a hurry, the short way in; otherwise an entailment in the reader's own morph, for this occasion."
    must: []
    decided: []
    takes: [{name: p, type: package}, {name: mine, type: morph}, {name: now, type: context}]
    gives: [{name: r, type: short}]
    lines: "11-24"
    order: 2
    body: |
      program read-my-way
        why: a package is read on the reader's terms: in a hurry, the short way in;
             otherwise an entailment in the reader's own morph, for this occasion.

        takes p: package, mine: morph, now: context
        gives r: short

        let f = fabula of p
        if now.medium is "phone" and now.hurry then
          give expand (atem f) with f to 300 words     -- the short way in
        else
          give read f with mine in now                 -- an entailment in my morph, labelled a reading
        end
      end
    steps: [P:step/read-my-way.1, P:step/read-my-way.2]
    provenance: {mode: derived, sources: ["read-my-way.thym#L11-L24"], confidence: 1}

