  name: join-the-notes
  summary: Notes given one by one, joined in the order they were given, with the words of each counted.
  why: notes given one by one, joined in the order they were given, with the words of each counted.
  must: []
  decided: []
  takes:
  - name: notes
    type: list of short
  gives:
