oes: thym/1
kind: plan
id: thym/plan.open-house
name: open-house on meadow
# The plan of programs/open-house.thym over the public sample Holotype ../cosm/holotypes/meadow, written by hand for
# the conformance suite (docs/THYM.md 11.1, 17.3). Nothing asks the model. A for each over a volume known only at run
# time gives one node marked repeats; a filter expression (h where ...) folds into the node that consumes it; the
# marked modifier is a mark node of its own. The input's sha256 is its catalog file's. Compared without run ids,
# timestamps and prompt token counts.
program: {name: open-house, sha256: 79df51f9ad8a8db5a31572b59c8a2de4a8aed946b6d11ceb5487b97c2426e0cc}
inputs: [{name: h, type: volume, path: ../cosm/holotypes/meadow, sha256: b27e86f12b2b2d588cbdaa47c82d160a60cc2056030050088bfc31a9e6f5a5d7}]
estimate: {steps: 7, asks: 0, largest_prompt: 0, output_words: 0}
