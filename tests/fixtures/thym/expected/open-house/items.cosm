# The enumeration of programs/open-house.thym, written by hand for the conformance suite (docs/THYM.md 10, 17.3).
# A move declared inside a program is a P:move item named after both, with a body and lines but no order (the
# program's body already holds it); a for each is one step whose body holds the steps inside it.
source: {path: open-house.thym, sha256: 79df51f9ad8a8db5a31572b59c8a2de4a8aed946b6d11ceb5487b97c2426e0cc, size: 853}
