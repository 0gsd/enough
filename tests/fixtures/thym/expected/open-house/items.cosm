nodes:
  - id: P:program/open-house
    type: program
    name: open-house
    summary: "Show what the house sells and what it wants, as the house says them; say how many people only in bands; keep everything internal inside."
    why: "show what the house sells and what it wants, as the house says them; say how many people only in bands; keep everything internal inside."
    must: []
    decided: []
    takes: [{name: h, type: volume}]
    gives: [{name: i, type: volume}]
    lines: "3-24"
    order: 1
    body: |
      program open-house
        why: show what the house sells and what it wants, as the house says them; say how many
             people only in bands; keep everything internal inside.

        takes h: volume                  -- the holotype
        gives i: volume                  -- an isotype: comprise-isotype/0, and no more

        move offer-line(o: item): item
          give mark o as verified        -- an offer is what the house does now: verified
        end

        for each o in h where kind in [product, service, platform]
          emit offer-line o
        end
        for each a in h where kind is aim
          emit mark a as stated          -- an aim is the house's own words: stated
        end
        let staff = h where module is employees
        emit employees: band (count staff) as [none, some] marked verified     -- never a number
        withhold h where visibility is internal
        give project h as isotype
      end
    moves: [P:move/open-house.offer-line]
    steps: [P:step/open-house.1, P:step/open-house.3, P:step/open-house.5, P:step/open-house.6, P:step/open-house.7,
            P:step/open-house.8]
    provenance: {mode: derived, sources: ["open-house.thym#L3-L24"], confidence: 1}

