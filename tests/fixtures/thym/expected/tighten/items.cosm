- id: P:check/shorter
  type: check
  name: shorter
  summary: A reworded line says less in fewer words, never more.
  why: a reworded line says less in fewer words, never more.
  params:
  - name: new
    type: line
  - name: old
    type: line
  lines: 3-7
  order: 1
  body: |+
    contract shorter(new: line, old: line)
      why: a reworded line says less in fewer words, never more.

      assert words new < words old else "the reworded line is not shorter than the line it replaces"
    end

  steps:
  - P:step/shorter.1
  provenance:
    mode: derived
    sources:
    - tighten.thym#L3-L7
    confidence: 1
