- id: P:check/counted-some
  type: check
  name: counted-some
  summary: A count of a text's words finds some, and never more than the text holds.
  why: a count of a text's words finds some, and never more than the text holds.
  params:
  - name: n
    type: number
  - name: t
    type: text
  lines: 3-9
  order: 1
  body: |+
    contract counted-some(n: number, t: text)
      why: a count of a text's words finds some, and never more than the text holds.

      let all = words t
      assert n > 0 else "the text has no words"
      assert not n > all else "more words were counted than the text holds"
    end

  steps:
  - P:step/counted-some.1
  - P:step/counted-some.2
  - P:step/counted-some.3
  provenance:
    mode: derived
    sources:
    - contract-holds.thym#L3-L9
    confidence: 1
