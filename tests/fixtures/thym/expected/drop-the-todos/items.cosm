- id: P:program/drop-the-todos
  type: program
  name: drop-the-todos
  summary: Every line that still says TODO leaves the draft, and nothing else changes.
  why: every line that still says TODO leaves the draft, and nothing else changes.
  must: []
  decided: []
  takes:
  - name: draft
    type: text
  gives:
  - name: clean
    type: text
  lines: 3-13
  order: 1
  body: |
    program drop-the-todos
      why: every line that still says TODO leaves the draft, and nothing else changes.

      takes draft: text
      gives clean: text

      let changes = for each l in lines of draft where "TODO" in l
        keep drop l
      end
      give edit draft with changes
    end
  steps:
  - P:step/drop-the-todos.1
  - P:step/drop-the-todos.3
  provenance:
