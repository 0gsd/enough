  # ---- K: the ideas the text uses
  - id: K:concept/cross-pollination
    type: concept
    name: cross-pollination
    summary: An apple tree sets fruit only with pollen from a second variety nearby.
    defined-by: L:term/pollinate
    span: {lines: "7-8"}
    provenance: {mode: manual, sources: ["notes.md#L7-L8"], confidence: 0.9}
  - id: K:concept/pollinator-habitat
    type: concept
    name: pollinator habitat
    summary: Uncut wildflowers that feed the insects an orchard needs to set fruit.
    span: {lines: "18-19"}
    provenance: {mode: manual, sources: ["notes.md#L18-L19"], confidence: 0.85}
    links:
