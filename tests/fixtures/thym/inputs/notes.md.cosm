# Written by hand as a test fixture: a full twin, every kind of item once at least. A model's twin also says model:.
derived: {at: 2026-10-22T10:30:00Z, by: hand, mode: model, completeness: full, chunks: 1}
atem:
  line: "The orchard's juice rose this year for reasons still argued over, and mowing the meadow strip in July would starve the pollinators its fruit depends on."
  focus: "A small orchard's good year, and a mowing date that could undo it."
  push: "Ask the parish council to wait until September before mowing the meadow strip."
  pull: "Whether leaf mould or a wet spring raised the yield, and whether the lease lets the parish mow at all."

nodes:
  # ---- L: the words the text leans on, grounded in FEED
  - id: L:term/pollinate
    type: term
    name: pollinate
    summary: To carry pollen from one flower to another so that fruit can set.
    feed: {word: pollinate, pos: verb, origin: feed}
    sense: To carry pollen from one flower to another so that fruit can set.
    span: {lines: "7-8"}
    provenance: {mode: manual, sources: ["notes.md#L7-L8"], confidence: 0.9}
  - id: L:term/variety
    type: term
    name: variety
    summary: A named, cultivated kind of apple; the text's sense of the word.
    feed: {word: variety, pos: noun, origin: feed}
    sense: A cultivated kind of apple tree, such as Bramley (the text's own sense, narrower than FEED's).
    span: {lines: "7"}
    provenance: {mode: manual, sources: ["notes.md#L7"], confidence: 0.8}
  - id: L:term/mulch
    type: term
    name: mulch
    summary: A layer of organic matter spread over soil to keep it moist and feed it.
    feed: {word: mulch, pos: noun; verb, origin: feed}
    sense: A layer of organic matter spread over soil to keep it moist and feed it.
    span: {lines: "14"}
    provenance: {mode: manual, sources: ["notes.md#L14"], confidence: 0.9}
  - id: L:term/leaf-mould
    type: term
    name: leaf mould
    summary: Fallen leaves left to rot into a dark, crumbly mulch.
    feed: {pending: "not in FEED"}
    sense: Fallen leaves left to rot into a dark, crumbly mulch.
    span: {lines: "13"}
    provenance: {mode: manual, sources: ["notes.md#L13"], confidence: 0.8}
    links:
      - {rel: is-a, to: L:term/mulch}

  # ---- E: the particular things and people named
  - id: E:person/mara-okafor
    type: person
    name: Mara Okafor
    summary: Mara Okafor has kept the Hollins Lane orchard since 2019.
