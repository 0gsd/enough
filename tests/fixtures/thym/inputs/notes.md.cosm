  # ---- P: what the text claims, and how it knows
  - id: P:claim/bramley-is-oldest
    type: claim
    name: the Bramley is the oldest tree
    summary: Mara Okafor says the Bramley by the gate is the oldest tree on Hollins Lane; the parish records do not confirm it.
    stance: hearsay
    salience: low
    roles: {source: E:person/mara-okafor, about: E:thing/bramley-by-the-gate}
    span: {lines: "3-5"}
    provenance: {mode: manual, sources: ["notes.md#L3-L5"], confidence: 0.9}
  - id: P:claim/apples-need-a-second-variety
    type: claim
    name: apples need a second variety
    summary: Every apple tree needs a second apple variety nearby to set fruit.
    stance: axiom
    salience: high
    roles: {claim: K:concept/cross-pollination, instrument: L:term/variety}
    span: {lines: "7-8"}
    provenance: {mode: manual, sources: ["notes.md#L7-L8"], confidence: 0.95}
    links:
      - {rel: exemplifies, to: K:concept/cross-pollination}
  - id: P:claim/juice-rose-to-140-litres
    type: claim
    name: the juice rose to 140 litres
    summary: The Hollins Lane orchard pressed 140 litres of juice this year, up from 90 litres last year; the writer counted the bottles on 12 October.
    stance: observed
    salience: critical
    roles: {actor: E:place/hollins-lane-orchard, measure: "140 litres, up from 90"}
    span: {lines: "10-11"}
    provenance: {mode: manual, sources: ["notes.md#L10-L11"], confidence: 0.95}
  - id: P:claim/mulch-raised-the-yield
    type: claim
    name: the leaf mould raised the yield
    summary: Mara Okafor holds that the leaf mould spread in March raised the Hollins Lane orchard's yield.
    stance: opinion
    salience: high
    roles: {holder: E:person/mara-okafor, cause: L:term/leaf-mould, effect: P:claim/juice-rose-to-140-litres}
    span: {lines: "13-14"}
    provenance: {mode: manual, sources: ["notes.md#L13-L14"], confidence: 0.9}
    links:
      - {rel: contradicts, to: P:claim/spring-explains-the-yield}
  - id: P:claim/spring-explains-the-yield
    type: claim
    name: a wet spring explains the yield
    summary: A warm, wet spring explains most of the rise in juice, because every orchard in the valley did well.
    stance: deduced
    salience: high
    roles: {cause: "a warm, wet spring", effect: P:claim/juice-rose-to-140-litres}
    span: {lines: "14-15"}
    provenance: {mode: manual, sources: ["notes.md#L14-L15"], confidence: 0.85}
    links:
      - {rel: contradicts, to: P:claim/mulch-raised-the-yield}
  - id: P:claim/july-mowing-harms-the-orchard
    type: claim
    name: July mowing would harm the orchard
    summary: Mowing the meadow strip in July would cut the wildflowers before they seed and so starve the pollinators the Hollins Lane orchard depends on.
    stance: deduced
    salience: critical
    roles: {actor: E:org/parish-council, claim: K:concept/pollinator-habitat, condition: "if the strip is mown in July"}
    span: {lines: "17-20"}
    provenance: {mode: manual, sources: ["notes.md#L17-L20"], confidence: 0.85}
    links:
      - {rel: depends-on, to: P:claim/apples-need-a-second-variety}
  - id: P:claim/strip-feeds-pollinators
    type: claim
    name: the strip exists for pollinators
    summary: The meadow strip exists to feed the pollinators the Hollins Lane orchard depends on.
    stance: assumed
    salience: normal
    roles: {about: K:concept/pollinator-habitat}
    span: {lines: "18-19"}
    provenance: {mode: manual, sources: ["notes.md#L18-L19"], confidence: 0.7}
    links:
