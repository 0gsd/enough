  - path: "README.md"
    text: |2
      # tiny

      Count the words of a text file, or list its commonest words.

          tiny count notes.txt            # 42
          tiny count notes.txt --lines    # 7
          tiny top notes.txt -n 2         # the: 5, and: 3

      Words are runs of letters, compared without case. A file that cannot be read is named on standard error,
      with exit status 1. `TINY_ENCODING` names the encoding to read with (UTF-8 when unset).

      Python 3.10 or later, standard library only.
  - path: "pyproject.toml"
    text: |2
      [project]
      name = "tiny-tool"
      version = "0.2.0"
      description = "Count the words of a text file."
      requires-python = ">=3.10"
      license = "MIT"
      dependencies = []

      [project.optional-dependencies]
      test = ["pytest>=8"]

      [project.scripts]
      tiny = "tiny.cli:main"

      [build-system]
      requires = ["setuptools>=68"]
      build-backend = "setuptools.build_meta"
  - path: "tests/test_counting.py"
    text: |2
      import pytest

      from tiny.counting import CountError, count_words, top_words


      def test_words_are_runs_of_letters():
          assert count_words("It's a dog-day, 2 dogs.") == 6


      def test_top_words_break_ties_by_letter():
          assert top_words("b a b a c", 2) == [("a", 2), ("b", 2)]


      def test_top_needs_one_or_more():
          with pytest.raises(CountError, match="n must be 1 or more"):
              top_words("a", 0)
