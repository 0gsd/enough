  hearsay:
    word: hearsay
    letter: h
    length: 7
    is_headword: 1
    pronunciation: /ˈhirˌseɪ/
    ipa: /ˈhirˌseɪ/
    definition: Information passed along secondhand, repeated from what someone else said rather than known firsthand.
      In law it names an out-of-court statement usually barred from testimony because it cannot be cross-examined.
    usage_note: null
    pos: noun
    pos_primary: noun
    synonyms:
