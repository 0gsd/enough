id: fabula/tally
name: tally
source: {path: tally/, kind: folder, language: python, files: 9, bytes: 11325, skipped: 0, tree: 0f26fb8759b9780f4131d6f6fbc541089d441051baaf1d88fa52023b30cadaea, licence: MIT}
derived: {at: 2026-11-05T14:02:40Z, by: person, model: anthropic/claude-opus-5.5, route: cloud, provider: openrouter, program: build-fabulac.thym, run: 2026-11-05-1351-e4f2, mode: model, completeness: full, chunks: 9, stages: [survey, history, read, fold, question]}
atem:
  line: tally counts named things from the command line in an append-only ledger, so concurrent adds are never lost and any add can be undone.
  focus: A three-command tool, add, show and undo, over a ledger file that is only ever appended to.
  push: Count small things without a spreadsheet, and trust the counts, because nothing is ever overwritten.
  pull: The safety of concurrent adds rests on the operating system appending one short line at a time, which the code assumes and does not check.
shorts:
  - {path: tally.cshort-2026-11-05-1412/, at: 2026-11-05T14:12:09Z, by: anthropic/claude-opus-5.5, mode: model, order: code, route: cloud, language: python, files: 6}
catems:
