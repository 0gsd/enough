  # --- what happens -------------------------------------------------------------------------------------------------
  - id: C:behaviour/add
    type: behaviour
    name: An add appends and reports
    summary: tally add checks the name and the number, appends one line to the ledger, then reads the whole ledger back and prints the name's new total.
    stance: observed
    of: [C:interface/command.add, C:interface/tally.ledger.add]
    when: tally add NAME [N]
    does: 'Strips NAME; refuses an empty name, a name with whitespace, or N of 0; creates the ledger''s folder if needed; appends {"at", "delta", "name"}; prints NAME: TOTAL.'
    edges:
      - {given: 'tally add pages -2', then: 'a negative N is read as the number, not an option; pages goes down by 2'}
      - {given: a ledger that does not exist yet, then: 'it is created, with its parent folders'}
    errors:
      - {when: 'tally add "two words"', message: 'tally: a name is one word, with no spaces', exit: 1}
      - {when: tally add tea 0, message: 'tally: adding 0 changes nothing', exit: 1}
      - {when: tally add with no name, message: argparse's usage and its 'the following arguments are required' line, exit: 2}
    span: {file: tally/ledger.py, lines: "61-70"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L52-L70', 'tally/cli.py#L36-L39'], confidence: 0.9, state: known}
  - id: C:behaviour/undo
    type: behaviour
    name: Undo walks back
    summary: tally undo looks back from the newest line for an add that is neither an undo nor already undone, and appends its opposite naming its line.
    stance: observed
    of: [C:interface/command.undo, C:interface/tally.ledger.undo]
    when: tally undo
    does: 'Reads every entry; collects the line numbers that undo entries name; from the last entry to the first, takes the first that has no undoes and is not named; appends {name, delta: -delta, undoes: its line}; prints "undid D on NAME; NAME: TOTAL", D being the cancelled entry''s delta with its sign (undid +1, undid -2).'
    edges:
      - {given: undo after undo, then: the second cancels the add before the first's; an undo is never itself undone}
      - {given: 'every add already undone, or an empty ledger', then: 'prints "nothing to undo", writes nothing, exit 0'}
    span: {file: tally/ledger.py, lines: "73-84"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L73-L84', 'tally/cli.py#L48-L54'], confidence: 0.9, state: known}
  - id: C:behaviour/read
    type: behaviour
    name: Reading the ledger
    summary: A missing ledger is empty; blank lines are skipped; any other line that is not an entry stops the command with its line number.
    stance: observed
    of: [C:interface/tally.ledger.read]
    when: any command
    does: Reads the file as UTF-8, numbers its lines from 1 (blank lines counted), skips blank ones, and builds one Entry per line.
    errors:
      - {when: 'a line is not a JSON object with at, name and delta', message: 'tally: <path>: line <n> is not a tally entry', exit: 1}
    span: {file: tally/ledger.py, lines: "36-49"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L36-L49'], confidence: 0.9, state: known}
  - id: C:behaviour/show
    type: behaviour
    name: Show draws bars
    summary: tally show prints one row per name, the name padded, the total right-aligned and a bar of '#' scaled so the largest positive total gets 30.
    stance: observed
    of: [C:interface/command.show, C:interface/tally.render.rows]
    when: tally show [--all] [--json]
    does: 'Names in alphabetical order; a total of 0 is left out unless --all; each row is NAME padded to the longest name, two spaces, TOTAL right-aligned to the widest total, two spaces, the bar, with trailing space removed; a bar is round(total * 30 / largest positive total) characters, at least one for any positive total; a negative total has no bar. --json prints the same totals (0 left out unless --all) as one JSON object with sorted keys.'
    edges:
      - {given: 'totals {a: 10, bb: 1, c: 0}', then: ['a   10  ##############################', 'bb   1  ###']}
      - {given: 'totals {a: -2}', then: ['a  -2']}
      - {given: no rows to show, then: 'prints empty_message: "nothing tallied yet (or every total is 0; try --all)", or "nothing tallied yet" with --all'}
    intended: {pending: "is hiding totals of 0 by default intended, or a choice users would change?"}
    span: {file: tally/render.py, lines: "8-25"}
    provenance: {mode: derived, sources: ['tally/render.py#L8-L29', 'tally/cli.py#L40-L47'], confidence: 0.9, state: known}
  - id: C:behaviour/errors
    type: behaviour
    name: Errors and exit status
    summary: 'A LedgerError is printed as "tally: <message>" on standard error with exit status 1; a usage error is argparse''s, exit status 2.'
    stance: observed
    of: [C:interface/tally.cli.main]
    when: any command
    does: main catches LedgerError only; any other exception is not caught.
    span: {file: tally/cli.py, lines: "55-58"}
    provenance: {mode: derived, sources: ['tally/cli.py#L55-L58'], confidence: 0.9, state: known}
