  # === P: claims and cases ========================================================================================
  - id: P:claim/one-line-appends-are-whole
    type: claim
    name: A one-line append lands whole
    summary: tally assumes that the operating system writes each appended ledger line whole, so two shells appending at once interleave whole lines.
    stance: assumed
    salience: high
    roles: {holder: C:component/ledger, subject: C:interface/format.ledger-line}
    span: {file: tally/ledger.py, lines: "52-58"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L52-L58', 'README.md#L11-L12'], confidence: 0.6, state: known}
  - id: P:case/add-and-totals
    type: case
    name: Adds fold into totals
    summary: Two adds to tea and one to walks give totals tea 3 and walks 1.
    stance: observed
    of: [C:interface/tally.ledger.add, C:interface/tally.ledger.totals]
    given: {calls: ['add(p, "tea", now=1.0)', 'add(p, "tea", 2, now=2.0)', 'add(p, "walks", now=3.0)']}
    expect: {value: 'totals(read(p)) == {"tea": 3, "walks": 1}'}
    span: {file: tests/test_tally.py, lines: "8-13"}
    provenance: {mode: derived, sources: ['tests/test_tally.py#L8-L13'], confidence: 1, state: known}
  - id: P:case/undo-walks-back
    type: case
    name: Undo walks back, never undoing an undo
    summary: After two adds, the first undo names line 2, the second line 1, the third finds nothing, and every total is 0.
    stance: observed
    of: [C:behaviour/undo, N:requirement/never-rewrite]
    given: {calls: ['add(p, "tea", now=1.0)', 'add(p, "walks", 2, now=2.0)', 'undo(p) three times']}
    expect: {value: 'undoes 2, then 1, then None; totals {"tea": 0, "walks": 0}'}
    span: {file: tests/test_tally.py, lines: "16-23"}
    provenance: {mode: derived, sources: ['tests/test_tally.py#L16-L23'], confidence: 1, state: known}
  - id: P:case/bad-names-and-zero
    type: case
    name: Bad names and zero are refused
    summary: A name with a space and a delta of 0 both raise LedgerError, and the ledger is not created.
    stance: observed
