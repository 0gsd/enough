    provenance: {mode: derived, sources: ['README.md#L1-L3'], confidence: 0.9, state: known}
  - id: L:term/ledger
    type: term
    name: ledger
    summary: The code's word for the file that holds every count ever added.
    feed: {word: ledger, pos: noun, origin: feed}
    sense: The append-only file of entries from which every total is folded.
    span: {file: tally/ledger.py, lines: "1-5"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L1-L5'], confidence: 0.9, state: known}
  - id: L:term/total
    type: term
    name: total
    summary: The sum of every entry for one name.
    feed: {word: total, pos: noun, origin: feed}
    sense: The sum of the deltas of every entry with that name, undo entries included.
    span: {file: tally/ledger.py, lines: "87-92"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L87-L92'], confidence: 0.9, state: known}
  - id: E:org/meadow
    type: org
    name: Meadow Software
    summary: Meadow Software, the holder of tally's copyright.
    span: {file: LICENSE, lines: "3"}
    provenance: {mode: derived, sources: ['LICENSE#L3'], confidence: 0.9, state: known}
  - id: K:concept/append-only-log
    type: concept
    name: append-only log
    summary: A file that is only ever added to at its end, so that every earlier state can be read back from it.
    defined-by: N:decision/append-only-log
    span: {file: tally/ledger.py, lines: "1-5"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L1-L5'], confidence: 0.9, state: known}
  # === N: Intent ==================================================================================================
  - id: N:aim/count-without-loss
    type: aim
    name: Count from a shell, and lose nothing
    summary: tally sets out to let a person count named things from a shell, with counts that are never lost and adds that can be undone.
    stance: observed
    measure: Every add made is reflected in show, two shells adding at once lose nothing, and undo walks back as far as asked.
    roles: {for: N:audience/shell-users}
    span: {file: README.md, lines: "1-11"}
    provenance: {mode: derived, sources: ['README.md#L1-L11'], confidence: 0.9, state: known}
  - id: N:audience/shell-users
    type: audience
    name: People who live in a terminal
    summary: People who keep a terminal open and want to count small things, cups of tea, walks, pages, without a spreadsheet.
    stance: deduced
    who: a person at a terminal, who can type a command and set an environment variable
    needs: A count that is quick to bump and quick to read, and that survives two shells at once.
    span: {file: README.md, lines: "3"}
    provenance: {mode: derived, sources: ['README.md#L3'], confidence: 0.7, state: known}
  - id: N:use/count-something
    type: use
    name: Count something
    summary: A person adds to a named count and sees its new total at once.
    stance: observed
    for: N:audience/shell-users
    via: [C:interface/command.add]
    steps: ['tally add tea', 'tally add pages 12', 'tally add pages -2']
    gets: 'One line, NAME: TOTAL, after each add.'
    span: {file: README.md, lines: "5-7"}
    provenance: {mode: derived, sources: ['README.md#L5-L7'], confidence: 0.9, state: known}
  - id: N:use/see-the-totals
    type: use
    name: See every total
    summary: A person lists every name with its total and a bar, or as JSON for another program.
    stance: observed
    for: N:audience/shell-users
    via: [C:interface/command.show]
    steps: ['tally show', 'tally show --all', 'tally show --json']
    gets: One row per name with a bar scaled to the largest total, or one JSON object.
    span: {file: README.md, lines: "8"}
    provenance: {mode: derived, sources: ['README.md#L8'], confidence: 0.9, state: known}
  - id: N:use/take-it-back
    type: use
    name: Take an add back
    summary: A person cancels the latest add, and undoing again walks further back.
    stance: observed
    for: N:audience/shell-users
    via: [C:interface/command.undo]
    steps: ['tally undo', 'tally undo']
    gets: 'One line saying what was undone and the new total, or "nothing to undo".'
    span: {file: README.md, lines: "9"}
    provenance: {mode: derived, sources: ['README.md#L9'], confidence: 0.9, state: known}
  - id: N:requirement/never-rewrite
    type: requirement
    name: The ledger is never rewritten
    summary: Every change to the ledger appends a line; no line already written is ever changed or removed.
    stance: observed
    force: must
    met-by: [C:behaviour/add, C:behaviour/undo]
    checked-by: [P:case/undo-walks-back]
    span: {file: tally/ledger.py, lines: "1-5"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L1-L5', 'README.md#L11-L12'], confidence: 0.9, state: known}
  - id: N:requirement/no-lost-counts
    type: requirement
    name: Two shells never lose a count
    summary: Two shells adding at the same moment must both be counted.
    stance: hearsay
    force: must
    met-by: [C:behaviour/add]
    links: [{rel: depends-on, to: P:claim/one-line-appends-are-whole}]
    span: {file: README.md, lines: "11-12"}
    provenance: {mode: derived, sources: ['README.md#L11-L12'], confidence: 0.7, state: known}
  - id: N:requirement/standard-library
    type: requirement
    name: Standard library only
    summary: tally runs on Python 3.10 or later with the standard library alone.
    stance: observed
    force: must
    met-by: [C:dependency/python-standard-library]
    span: {file: README.md, lines: "14"}
    provenance: {mode: derived, sources: ['README.md#L14'], confidence: 0.9, state: known}
  - id: N:decision/append-only-log
    type: decision
    name: An append-only log, not a totals file
    summary: In 0.2 the ledger became an append-only log of entries instead of one JSON file of totals rewritten on every add.
    stance: observed
    chose: one JSON object per line, appended, with totals folded from the whole log when needed
    over:
      - {option: 'one JSON file of totals, rewritten on every add (0.1)', because: 'two adds at once could lose one, and nothing could be undone'}
    because: Appending never loses an earlier count and keeps every step, so undo can walk back.
    by: R:maker/meadow
    changed-in: [R:change/append-only-log]
    span: {file: CHANGES.md, lines: "5-6"}
    provenance: {mode: derived, sources: ['CHANGES.md#L5-L6'], confidence: 0.9, state: known}
  - id: N:decision/undo-by-opposite
    type: decision
    name: Undo appends the opposite
    summary: An undo appends the opposite of the entry it cancels and names that entry's line, instead of removing anything.
    stance: deduced
    chose: append an entry with the opposite delta and undoes set to the cancelled line's number
    over:
      - {option: remove the last line, because: 'it would rewrite the ledger, which the log forbids'}
    because: It keeps the ledger append-only, and naming the cancelled line lets a second undo skip it and walk further back.
    changed-in: [R:change/undo-added]
    span: {file: tally/ledger.py, lines: "73-84"}
    provenance: {mode: derived, sources: ['tally/ledger.py#L73-L84'], confidence: 0.8, state: known}
  - id: N:exclusion/old-ledger
    type: exclusion
    name: 0.1's ledger is not read
    summary: tally 0.2 does not read 0.1's ~/.tally.json; its totals are carried over by hand, one add each.
    stance: observed
    horizon: {pending: "will 0.1's ledger ever be read again, or never?"}
    because: The two files hold different things, totals and entries.
    span: {file: CHANGES.md, lines: "9"}
    provenance: {mode: derived, sources: ['CHANGES.md#L9'], confidence: 0.9, state: known}
