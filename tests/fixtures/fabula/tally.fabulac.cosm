      - {name: --json, type: flag, means: 'print one JSON object, keys sorted, instead of rows'}
    gives: {output: 'the rows of tally.render.rows, or its empty message; with --json, one JSON object', exit: 0}
    exported: true
    span: {file: tally/cli.py, lines: "25-27"}
    provenance: {mode: derived, sources: ['tally/cli.py#L25-L27', 'tally/cli.py#L40-L47'], confidence: 1, state: known}
