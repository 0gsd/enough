    given: {calls: ['add(p, "two words")', 'add(p, "tea", 0)']}
    expect: {raises: [LedgerError matching "one word", LedgerError matching "changes nothing"], files: the ledger does not exist}
    span: {file: tests/test_tally.py, lines: "26-32"}
    provenance: {mode: derived, sources: ['tests/test_tally.py#L26-L32'], confidence: 1, state: known}
  - id: P:case/broken-line
