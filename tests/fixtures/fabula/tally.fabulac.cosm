nodes:
  # === I: Inspiration =============================================================================================
  - id: I:occasion/lost-counts
    type: occasion
    name: Counts lost by 0.1
    summary: The change to a log was prompted by 0.1 losing a count when two adds rewrote its totals file at once.
    stance: observed
    roles: {event: R:change/append-only-log}
    when: 2026-10
    span: {file: CHANGES.md, lines: "5-6"}
    provenance: {mode: derived, sources: ['CHANGES.md#L5-L6'], confidence: 0.8, state: known}
  - id: I:occasion/first-need
    type: occasion
    name: What set tally going
