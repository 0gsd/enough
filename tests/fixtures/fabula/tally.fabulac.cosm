  # --- the command line ----------------------------------------------------------------------------------------------
  - id: C:interface/command.tally
    type: interface
    name: tally
    summary: The program, with three subcommands and --version; a subcommand is required.
    stance: observed
    surface: command
    signature: 'tally [-h] [--version] {add,show,undo} ...'
    defined-in: C:file/tally--cli-py
    takes:
      - {name: --version, means: 'print "tally 0.2.0" and exit 0'}
      - {name: command, required: true, means: 'add, show or undo'}
    gives: {exit: '0 done; 1 a ledger error (message on standard error); 2 a usage error (argparse''s message)'}
    exported: true
    span: {file: tally/cli.py, lines: "18-29"}
    provenance: {mode: derived, sources: ['tally/cli.py#L18-L29'], confidence: 1, state: known}
  - id: C:interface/command.add
    type: interface
    name: tally add
    summary: Adds N to the count called NAME and prints the new total.
    stance: observed
    surface: command
    signature: 'tally add [-h] name [n]'
    defined-in: C:file/tally--cli-py
    takes:
      - {name: name, type: str, required: true, means: 'one word, no spaces'}
      - {name: n, type: int, default: 1, means: 'what to add; may be negative (tally add pages -2); never 0'}
    gives: {output: 'NAME: TOTAL', exit: 0}
    raises:
      - {error: LedgerError, when: the name is empty or holds a space, message: 'tally: a name is one word, with no spaces'}
      - {error: LedgerError, when: n is 0, message: 'tally: adding 0 changes nothing'}
    exported: true
    span: {file: tally/cli.py, lines: "22-24"}
    provenance: {mode: derived, sources: ['tally/cli.py#L22-L24', 'tally/cli.py#L36-L39'], confidence: 1, state: known}
  - id: C:interface/command.show
