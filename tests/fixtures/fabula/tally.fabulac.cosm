    stance: assumed
    roles: {event: {pending: "what problem or moment set tally going?"}}
    provenance: {mode: derived, sources: ['README.md#L1-L3'], confidence: 0.2, state: pending}
  # === L E K ======================================================================================================
  - id: L:term/tally
    type: term
    name: tally
    summary: The program's name and its verb, to keep a running count.
    feed: {word: tally, pos: verb, origin: feed}
    sense: To keep a running count of something.
