  - id: C:interface/tally.ledger.add
    type: interface
    name: add
    summary: Appends one count to the ledger and returns the entry written.
    stance: observed
    surface: function
    signature: 'def add(path: Path, name: str, delta: int = 1, now: float | None = None) -> Entry'
    defined-in: C:file/tally--ledger-py
    takes:
      - {name: path, type: Path}
      - {name: name, type: str, means: stripped of surrounding space before it is checked}
      - {name: delta, type: int, default: 1}
      - {name: now, type: 'float | None', default: None, means: 'the entry''s time; None is time.time()'}
