- id: P:case/tests.test_reachability.while-loops
  type: case
  name: while loops with constant conditions
  summary: while False is an item "while" over the whole loop; the else of while True is an item "else"; the code
    after a while True with no break that reaches it is an item "while"; a break in the loop (not in a nested loop)
    makes it reachable.
  stance: observed
  of:
  - C:interface/vulture.reachability.Reachability.visit
  - C:interface/vulture.utils.condition_is_always_true
  - C:interface/vulture.utils.condition_is_always_false
  given:
    input: '"while False:\n    pass\n" -> [(1, 2, while)]

      "while True:\n    while False:\n        pass\n" -> [(2, 2, while)]

      "while True:\n    print(\"I won''t stop\")\nelse:\n    print(\"I won''t run\")\n" -> [(4, 1, else)]

      "while True:\n    raise Exception()\nprint(\":-(\")\n" -> [(3, 1, while)]

      "while True:\n    if a > 3:\n        raise Exception()\n    else:\n        pass\nprint(\":-(\")\n" -> [(6,
      1, while)]

      "while True:\n    for _ in range(3):\n        break\n    while False:\n        break\nprint(\":-(\")\n" ->
      [(4, 2, while), (6, 1, while)]   (a break inside a nested loop does not leave the outer while)

      "while True:\n    break\nprint(\":-)\")\n" -> []

      "while True:\n    if a > 3:\n        raise Exception()\n    else:\n        break\nprint(\":-(\")\n" -> []

      "def foo(a):\n    while a > 0:\n        return 1\n    print(\":-)\")\n" -> []

      "def foo():\n    while True:\n        if condition:\n            break\n        for item in items:\n            process(item)\n    return
      \"reachable\"\n" -> []

      "def foo():\n    while True:\n        for i in items:\n            process(i)\n        if condition:\n            break\n        for
      j in others:\n            finalize(j)\n    return \"reachable\"\n" -> []'
  expect:
    value: v.unreachable_code holds exactly the items listed, in order
