- id: P:case/tests.test_size.class-sizes
  type: case
  name: The size in lines of a top-level class
  summary: get_last_line_number(node) - get_first_line_number(node) + 1 for the class Foo gives the number of lines
    from its first decorator (or class line) to the last line of its last statement; comments after the last statement
    do not count.
  stance: observed
  of:
  - C:interface/vulture.lines.get_first_line_number
  - C:interface/vulture.lines.get_last_line_number
  given:
    calls:
    - 'tree = ast.parse(example); for the top-level ClassDef named Foo: get_last_line_number(node) - get_first_line_number(node)
      + 1'
    input: 'Each example starts with an empty line, then the class (the size counts from the class or its first
      decorator).

      "class Foo:\n    foo = 1\n    bar = 2\n" -> 3

      "class Foo(object):\n    def bar():\n        pass\n\n    @staticmethod\n    def func():\n        if \"foo\"
      == \"bar\":\n            return \"xyz\"\n        import sys\n        return len(sys.argv)\n" -> 10

      "@identity\nclass Foo(object):\n    @identity\n    @identity\n    def bar(self):\n        if \"a\" == \"b\":\n            pass\n        elif
      \"b\" == \"c\":\n            pass\n        else:\n            pass\n" -> 11

      "@foo\n@property\n@xoo\nclass Foo:\n    def zoo(self):\n        pass\n" -> 6

      "class Foo:\n    while 1:\n        print(1)\n" -> 3

      "class Foo:\n    while \"b\" > \"a\":\n        pass\n    else:\n        pass\n" -> 5

      "class Foo:\n    with open(\"/dev/null\") as f:\n        f.write(\"\")\n" -> 3

      "class Foo:\n    try:\n        x = sys.argv[99]\n    except IndexError:\n        pass\n    except Exception:\n        pass\n    else:\n        pass\n"
      -> 9

      "class Foo:\n    try:\n        1/0\n    finally:\n        return 99\n" -> 5   (skipped on Python 3.14 and
      later)

      "class Foo:\n    try:\n        foo()\n    except:\n        bar()\n" -> 5

      "class Foo:\n    try:\n        foo()\n    except IOError:\n        bar()\n    except AttributeError:\n        pass\n"
      -> 7

      "class Foo:\n    for i in range(10):\n        print(i)\n" -> 3

      "class Foo:\n    for arg in sys.argv:\n        print(\"loop\")\n    else:\n        print(\"else\")\n" -> 5

      "class Foo:\n    class Bar:\n        pass\n" -> 3

      "class Foo:\n    def foo():\n        return (\n            ''very''\n            ''long''\n            ''string'')\n"
      -> 6

      "class Foo:\n    def bar():\n        # A comment.\n        pass\n        # This comment won''t be detected.\n"
      -> 4

      "class Foo:\n    def bar():\n        yield something\n" -> 3

      "class Foo:\n    exec(''a'')\n" -> 2

      "class Foo:\n    print(\n        ''foo'')\n" -> 3

      "class Foo:\n    print(\n        ''foo'',)\n" -> 3

      "class Foo:\n    return (True and\n        False)\n" -> 3

      "class Foo:\n    from a import b\n" -> 2

      "class Foo:\n    del a[:\n        foo()]\n" -> 3

      "class Foo:\n    [a\n     for a in\n     b]\n" -> 4

      "class Foo:\n    [a, b\n    ]\n" -> 3

      "class Foo:\n    bar[1:2,\n        ...]\n" -> 3

      "class Foo:\n    def foo():\n        bar(*a,\n            b=c)\n" -> 4

      "class Foo:\n    bar = foo(a, b)[c,:]\n" -> 2

      "class Foo:\n    async def foo(some_attr):\n        pass\n" -> 3

      "class Foo:\n    async def bar():\n        async with x:\n            pass\n" -> 4

      "class Foo:\n    async def foo():\n        async for a in b:\n            pass\n" -> 4'
  expect:
    value: the size given for each example (a missing class Foo fails the test with AssertionError 'Failed to find
      top-level class "Foo" in code')
  span:
    file: tests/test_size.py
    lines: 9-353
  provenance:
    mode: derived
    sources:
    - tests/test_size.py#L9-L353
    confidence: 0.9
    state: known
  made:
    move: derive
    run: 2026-11-05-2316-661d
    step: 1
    node: '1'
    engine: model:hand-g1c
  stands: inside
  from: test
