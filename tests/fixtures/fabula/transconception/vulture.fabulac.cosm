- id: C:interface/command.vulture
  type: interface
  name: vulture
  summary: The command line vulture.
  stance: observed
  surface: command
  signature: vulture [-h] [--exclude PATTERNS] [--ignore-decorators PATTERNS] [--ignore-names PATTERNS] [--make-whitelist]
    [--min-confidence MIN_CONFIDENCE] [--sort-by-size] [--config CONFIG] [--verbose] [--version] [paths ...]
  defined-in: C:file/vulture--config-py
  takes:
  - name: paths
    default: missing
    required: false
    means: Paths may be Python files or directories. For each directory Vulture analyzes all contained *.py files.
    metavar: PATH
  - name: --exclude
    type: csv
    default: missing
    means: Comma-separated list of path patterns to ignore (e.g., "*settings.py,docs,*/test_*.py,venv"). {glob_help}
      A PATTERN without glob wildcards is treated as *PATTERN*. Patterns are matched against absolute paths.
    metavar: PATTERNS
  - name: --ignore-decorators
    type: csv
    default: missing
    means: Comma-separated list of decorators. Functions and classes using these decorators are ignored (e.g., "@app.route,@require_*").
      {glob_help}
    metavar: PATTERNS
  - name: --ignore-names
    type: csv
    default: missing
    means: Comma-separated list of names to ignore (e.g., "visit_*,do_*"). {glob_help}
    metavar: PATTERNS
  - name: --make-whitelist
    type: flag
    default: missing
    means: Report unused code in a format that can be added to a whitelist module.
  - name: --min-confidence
    type: int
    default: missing
    means: Minimum confidence (between 0 and 100) for code to be reported as unused.
  - name: --sort-by-size
    type: flag
    default: missing
    means: Sort unused functions and classes by their lines of code.
  - name: --config
    type: str
    default: '"pyproject.toml"'
    means: Path to pyproject.toml config file.
  - name: --verbose
    type: flag
    default: missing
  - name: --version
    means: print the version and exit
  exported: true
  span:
    file: vulture/config.py
    lines: 110-175
  provenance:
    mode: derived
    sources:
