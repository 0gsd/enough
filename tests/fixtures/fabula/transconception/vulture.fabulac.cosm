- id: P:case/tests.test_conditions.complex-conditions
  type: case
  name: Boolean operators and not
  summary: Both condition functions evaluate and, or and not over partly unknown names.
  stance: observed
  of:
  - C:interface/vulture.utils.condition_is_always_false
  - C:interface/vulture.utils.condition_is_always_true
  given:
    input: 'expression -> (always_false, always_true)

      foo and False -> (True, False)

      foo or False -> (False, False)

      foo and True -> (False, False)

      foo or True -> (False, True)

      False and foo -> (True, False)

      False and 1 -> (True, False)

      not False -> (False, True)

      not True -> (True, False)

      not foo -> (False, False)

      foo and (False or []) -> (True, False)

      (foo and bar) or {"a": 1} -> (False, True)'
  expect:
    value: condition_is_always_false(expr) and condition_is_always_true(expr) equal the pair given for each expression;
      never both True
  span:
    file: tests/test_conditions.py
    lines: 38-56
  provenance:
    mode: derived
    sources:
    - tests/test_conditions.py#L38-L56
    confidence: 0.9
    state: known
  made:
    move: derive
    run: 2026-11-05-2316-661d
    step: 1
    node: '1'
    engine: model:hand-g1c
  stands: inside
  from: test
- id: P:case/tests.test_conditions.undecidable-conditions
  type: case
  name: Expressions that cannot be decided
  summary: Names, comparisons, calls and attribute access are neither always true nor always false.
  stance: observed
