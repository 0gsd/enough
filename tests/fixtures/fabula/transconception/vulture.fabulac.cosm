  - C:interface/vulture.utils.condition_is_always_true
  given:
    input: 'foo

      __name__ == "__main__"

      chr(-1)

      getattr(True, "foo")

      hasattr(str, "foo")

      isinstance(True, True)

      globals()

      locals()

      ().__class__'
  expect:
