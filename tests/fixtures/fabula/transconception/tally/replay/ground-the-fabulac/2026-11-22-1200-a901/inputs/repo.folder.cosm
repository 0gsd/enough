  - path: "README.md"
    text: |2
      # tally

      Count things from the command line: cups of tea, walks, pages read.

          python -m tally add tea         # tea: 1
          python -m tally add pages 12    # pages: 12
          python -m tally add pages -2    # pages: 10
          python -m tally show            # one row per name, with a bar
          python -m tally undo            # cancel the latest add

      Counts are kept in an append-only ledger, `~/.tally.jsonl`, or the file `$TALLY_FILE` names. Nothing in it is
      ever rewritten, so two shells adding at once never lose a count, and `undo` can always walk back.

      Python 3.10 or later, standard library only.
  - path: "tally/__init__.py"
    text: |2
      """tally: count things from the command line, in an append-only ledger."""
      __version__ = "0.2.0"
  - path: "tally/__main__.py"
    text: |2
      import sys

      from .cli import main

      sys.exit(main())
  - path: "tally/cli.py"
    text: |2
      """tally: count things from the command line.

          tally add NAME [N]      add N (default 1; may be negative) to NAME
          tally show [--all] [--json]
          tally undo              cancel the latest add that has not been undone

      The ledger is $TALLY_FILE, or ~/.tally.jsonl.
      """
      from __future__ import annotations

      import argparse
      import json
      import sys

      from . import __version__, ledger, render


      def build_parser() -> argparse.ArgumentParser:
          p = argparse.ArgumentParser(prog="tally", description="Count things from the command line.")
          p.add_argument("--version", action="version", version=f"tally {__version__}")
          sub = p.add_subparsers(dest="command", required=True)
          a = sub.add_parser("add", help="add to a count")
          a.add_argument("name")
          a.add_argument("n", nargs="?", type=int, default=1)
          s = sub.add_parser("show", help="show every total")
          s.add_argument("--all", action="store_true", help="include totals of 0")
          s.add_argument("--json", action="store_true", help="print the totals as one JSON object")
          sub.add_parser("undo", help="cancel the latest add")
          return p


      def main(argv: list[str] | None = None) -> int:
          args = build_parser().parse_args(argv)
          path = ledger.ledger_path()
          try:
              if args.command == "add":
                  e = ledger.add(path, args.name, args.n)
                  total = ledger.totals(ledger.read(path))[e.name]
                  print(f"{e.name}: {total}")
              elif args.command == "show":
                  totals = ledger.totals(ledger.read(path))
                  if args.json:
                      shown = {k: v for k, v in totals.items() if v != 0 or args.all}
                      print(json.dumps(shown, sort_keys=True))
                  else:
                      lines = render.rows(totals, show_all=args.all)
                      print("\n".join(lines) if lines else render.empty_message(args.all))
              elif args.command == "undo":
                  e = ledger.undo(path)
                  if e is None:
                      print("nothing to undo")
                  else:
                      total = ledger.totals(ledger.read(path))[e.name]
                      print(f"undid {-e.delta:+d} on {e.name}; {e.name}: {total}")
          except ledger.LedgerError as err:
              print(f"tally: {err}", file=sys.stderr)
              return 1
          return 0


      if __name__ == "__main__":
          sys.exit(main())
  - path: "tally/ledger.py"
    text: |2
      """The ledger: an append-only log of counts, one JSON object per line.

      Nothing in a ledger is ever rewritten. Adding appends an entry; undoing appends the opposite of an earlier entry
      and names it. Totals are folded from the whole log each time they are needed.
      """
      from __future__ import annotations

      import json
      import os
      import time
      from dataclasses import dataclass
      from pathlib import Path

      DEFAULT_NAME = ".tally.jsonl"


      class LedgerError(Exception):
          """A ledger that cannot be read or an entry that cannot be made; the message is shown to the user as it is."""


      @dataclass(frozen=True)
      class Entry:
          at: float                  # seconds since the epoch
          name: str
          delta: int
          undoes: int | None = None  # the line number (from 1) of the entry this one cancels


      def ledger_path(env: dict | None = None) -> Path:
          """$TALLY_FILE when it is set and not empty, else ~/.tally.jsonl."""
          env = os.environ if env is None else env
          given = env.get("TALLY_FILE", "").strip()
          return Path(given).expanduser() if given else Path.home() / DEFAULT_NAME


      def read(path: Path) -> list[Entry]:
          """Every entry, in the order written. A missing file is an empty ledger; blank lines are skipped."""
          if not path.exists():
              return []
          out = []
          for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
              if not line.strip():
                  continue
              try:
                  d = json.loads(line)
                  out.append(Entry(float(d["at"]), str(d["name"]), int(d["delta"]), d.get("undoes")))
              except (ValueError, KeyError, TypeError) as e:
                  raise LedgerError(f"{path}: line {n} is not a tally entry") from e
          return out


      def _append(path: Path, entry: Entry) -> None:
          record = {"at": entry.at, "name": entry.name, "delta": entry.delta}
          if entry.undoes is not None:
              record["undoes"] = entry.undoes
          path.parent.mkdir(parents=True, exist_ok=True)
          with path.open("a", encoding="utf-8") as f:
              f.write(json.dumps(record, sort_keys=True) + "\n")


      def add(path: Path, name: str, delta: int = 1, now: float | None = None) -> Entry:
          """Append one count. A name is one word; a delta may be negative but never 0."""
          name = name.strip()
          if not name or any(c.isspace() for c in name):
              raise LedgerError("a name is one word, with no spaces")
          if delta == 0:
              raise LedgerError("adding 0 changes nothing")
          entry = Entry(time.time() if now is None else now, name, delta)
          _append(path, entry)
          return entry


      def undo(path: Path, now: float | None = None) -> Entry | None:
          """Cancel the latest entry that is neither an undo nor already undone, by appending its opposite.
          None when there is nothing left to undo."""
          entries = read(path)
          cancelled = {e.undoes for e in entries if e.undoes is not None}
          for n in range(len(entries), 0, -1):
              e = entries[n - 1]
              if e.undoes is None and n not in cancelled:
                  back = Entry(time.time() if now is None else now, e.name, -e.delta, undoes=n)
                  _append(path, back)
                  return back
          return None


      def totals(entries: list[Entry]) -> dict[str, int]:
          """Each name's total, names in alphabetical order."""
          out: dict[str, int] = {}
          for e in entries:
              out[e.name] = out.get(e.name, 0) + e.delta
          return dict(sorted(out.items()))
  - path: "tally/render.py"
    text: |2
      """Drawing totals for a terminal: one row per name, a bar scaled to the largest total."""
      from __future__ import annotations

      BAR_WIDTH = 30
      BAR = "#"


      def rows(totals: dict[str, int], show_all: bool = False) -> list[str]:
          """One line per name: the name padded to the longest, the total right-aligned, then a bar.

          A total of 0 is left out unless show_all. A negative total gets no bar. The longest bar is BAR_WIDTH
          characters; every other bar is scaled to it and rounded, and a positive total always gets at least one."""
          shown = {k: v for k, v in totals.items() if v != 0 or show_all}
          if not shown:
              return []
          name_w = max(len(k) for k in shown)
          num_w = max(len(str(v)) for v in shown.values())
          top = max([v for v in shown.values() if v > 0], default=0)
          out = []
          for name, value in shown.items():
              bar = ""
              if value > 0 and top:
                  bar = BAR * max(1, round(value * BAR_WIDTH / top))
              out.append(f"{name.ljust(name_w)}  {str(value).rjust(num_w)}  {bar}".rstrip())
          return out


      def empty_message(show_all: bool) -> str:
          return "nothing tallied yet" if show_all else "nothing tallied yet (or every total is 0; try --all)"
  - path: "tests/test_tally.py"
    text: |2
      import json

      import pytest

      from tally import cli, ledger, render


      def test_add_and_totals(tmp_path):
          p = tmp_path / "t.jsonl"
          ledger.add(p, "tea", now=1.0)
          ledger.add(p, "tea", 2, now=2.0)
          ledger.add(p, "walks", now=3.0)
          assert ledger.totals(ledger.read(p)) == {"tea": 3, "walks": 1}


      def test_undo_walks_back_and_never_undoes_an_undo(tmp_path):
          p = tmp_path / "t.jsonl"
          ledger.add(p, "tea", now=1.0)
          ledger.add(p, "walks", 2, now=2.0)
          assert ledger.undo(p, now=3.0).undoes == 2
          assert ledger.undo(p, now=4.0).undoes == 1
          assert ledger.undo(p, now=5.0) is None
          assert ledger.totals(ledger.read(p)) == {"tea": 0, "walks": 0}


      def test_bad_names_and_zero_are_refused(tmp_path):
          p = tmp_path / "t.jsonl"
          with pytest.raises(ledger.LedgerError, match="one word"):
              ledger.add(p, "two words")
          with pytest.raises(ledger.LedgerError, match="changes nothing"):
              ledger.add(p, "tea", 0)
          assert not p.exists()


      def test_a_broken_line_names_its_number(tmp_path):
          p = tmp_path / "t.jsonl"
          p.write_text('{"at": 1, "name": "tea", "delta": 1}\nnot json\n', encoding="utf-8")
          with pytest.raises(ledger.LedgerError, match="line 2 is not a tally entry"):
              ledger.read(p)


      def test_rows_scale_bars_and_hide_zero():
          assert render.rows({"a": 10, "bb": 1, "c": 0}) == ["a   10  " + "#" * 30, "bb   1  ###"]
          assert render.rows({"a": -2}) == ["a  -2"]
          assert render.rows({"c": 0}) == []
          assert render.rows({"c": 0}, show_all=True) == ["c  0"]


      def test_cli_show_json_and_error_exit(tmp_path, monkeypatch, capsys):
          monkeypatch.setenv("TALLY_FILE", str(tmp_path / "t.jsonl"))
          assert cli.main(["add", "tea", "3"]) == 0
          assert cli.main(["show", "--json"]) == 0
          assert json.loads(capsys.readouterr().out.splitlines()[-1]) == {"tea": 3}
          assert cli.main(["add", "two words"]) == 1
          assert capsys.readouterr().err == "tally: a name is one word, with no spaces\n"
