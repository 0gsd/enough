- id: C:structure/sloppy_xml.patterns
  type: structure
  name: The regular expressions
  summary: The patterns PATTERNS compiles, each with FLAGS (MULTILINE and DOTALL), as written in the code.
  stance: observed
  shape: a dict from a pattern's name to a compiled regular expression
  fields:
  - name: start_tag
    type: regex
    default: <\s*([a-zA-Z_:][a-zA-Z0-9_:.-]*)\s*([^>]*?)(/?)>
  - name: end_tag
    type: regex
    default: </\s*([a-zA-Z_:][a-zA-Z0-9_:.-]*)\s*>
  - name: incomplete_tag
    type: regex
    default: <\s*([a-zA-Z_:][a-zA-Z0-9_:.-]*)\s*([^>]*?)$
  - name: attributes
    type: regex
    default: ([a-zA-Z_:][a-zA-Z0-9_:.-]*)\s*(?:=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+)))?
  - name: malformed_attr
    type: regex
    default: ([a-zA-Z_:][a-zA-Z0-9_:.-]*)\s*=\s*([^"'>\s][^>\s]*)
  - name: mixed_quotes
    type: regex
    default: ([a-zA-Z_:][a-zA-Z0-9_:.-]*)\s*=\s*(?:"([^"]*?)'|'([^']*?)")
  - name: entity_ref
    type: regex
    default: '&(?:([a-zA-Z][a-zA-Z0-9]*)|#(?:([0-9]+)|x([0-9a-fA-F]+)));?'
  - name: broken_entity
    type: regex
    default: '&([a-zA-Z][a-zA-Z0-9]*|#(?:[0-9]+|x[0-9a-fA-F]+))(?![;a-zA-Z0-9])'
  - name: comment
    type: regex
    default: <!--(.*?)-->
  - name: broken_comment
    type: regex
    default: <!--([^>]*?)(?:->|>|$)
  - name: cdata
    type: regex
    default: <!\[CDATA\[(.*?)(?:\]\]>|$)
  - name: broken_cdata
    type: regex
    default: <!\[CDATA\[(.*?)(?:\]>|>|$)
  - name: pi
    type: regex
    default: <\?([a-zA-Z_:][a-zA-Z0-9_:.-]*)\s*(.*?)(?:\?>|>|$)
  - name: whitespace
    type: regex
    default: \s+
  - name: text_content
    type: regex
    default: '[^<&]+'
  - name: unescaped_chars
    type: regex
    default: '[<>&]'
  - name: encoding_issues
    type: regex
    default: '[\x00-\x08\x0B\x0C\x0E-\x1F\x7F-\x9F]'
