    step: 1
    node: '1'
    engine: model:hand-g1
  ruling:
  - is: alike
    allowing: own-types
    because: an lxml-like builder in Rust's own types
    about: 'S-R20: the builder'
    made-for: N:target/rust
    by: R:maker/transconceiver
    'on': '2026-11-18'
    said: 'sitting 1, Q4: alike: Rust offers an lxml-like tree builder of its own under the name lxml, in Rust''s
      own types (tags, attributes, text, tail), printed by the driver like the original''s; sitting 2: a fifth allowance,
      own-types, on the closed list: a value may take the target''s own type where the kept interface cannot see
      the difference'
  - is: alike
    allowing: exit-only
    about: 'S-R20: the refusal of an unknown name'
