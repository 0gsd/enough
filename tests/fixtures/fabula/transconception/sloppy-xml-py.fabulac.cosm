- id: C:interface/sloppy_xml.stream_parse
  type: interface
  name: stream_parse
  summary: Parse XML input stream and yield parsing events.
  stance: observed
  surface: function
  signature: 'def stream_parse(xml_input: Union[str, TextIO], encoding: str = "utf-8", recover: bool = True, emit_errors:
    bool = False, preserve_whitespace: bool = False, resolve_entities: bool = True, namespace_aware: bool = False,
    max_depth: int = 1000, recovery_strategy: RecoveryStrategy = RecoveryStrategy.LENIENT, max_recovery_attempts:
    int = 10, collect_errors: bool = False, smart_quotes: bool = True, auto_close_tags: bool = True, fix_encoding:
    bool = True, normalize_whitespace: bool = False, allow_fragments: bool = True, repair_attributes: bool = True)
    -> Iterator[XMLEvent]'
  defined-in: C:file/sloppy-xml-py
  takes:
  - name: xml_input
    type: Union[str, TextIO]
    required: true
    means: an XML string or a file-like object to parse
  - name: encoding
    type: str
    default: '"utf-8"'
    required: false
    means: the text encoding used to decode bytes read from a file-like input
  - name: recover
    type: bool
    default: 'True'
    required: false
    means: enable error recovery for malformed XML
  - name: emit_errors
    type: bool
    default: 'False'
    required: false
    means: yield ParseError events for diagnostics
  - name: preserve_whitespace
    type: bool
    default: 'False'
    required: false
    means: keep whitespace-only text and stray whitespace characters
  - name: resolve_entities
    type: bool
    default: 'True'
    required: false
    means: resolve entity references in text and attribute values to characters
  - name: namespace_aware
    type: bool
    default: 'False'
    required: false
    means: fill StartElement.namespace from the xmlns:PREFIX attribute of a prefixed tag
  - name: max_depth
    type: int
    default: '1000'
    required: false
    means: the deepest nesting allowed before parsing stops with a fatal depth_exceeded error
  - name: recovery_strategy
    type: RecoveryStrategy
    default: RecoveryStrategy.LENIENT
    required: false
    means: STRICT turns off the recoveries that need LENIENT or AGGRESSIVE (broken comments and CDATA, escaping,
      missing semicolons, incomplete tags, smart quotes)
  - name: max_recovery_attempts
    type: int
    default: '10'
    required: false
    means: how many recoveries are allowed before parsing stops with a fatal recovery_limit error
  - name: collect_errors
    type: bool
    default: 'False'
    required: false
    means: keep all errors and yield them after every other event instead of where they arise
  - name: smart_quotes
    type: bool
    default: 'True'
    required: false
    means: enable smart quote matching
  - name: auto_close_tags
    type: bool
    default: 'True'
    required: false
    means: close tags left open at the end, and close an incomplete tag at once
  - name: fix_encoding
    type: bool
    default: 'True'
    required: false
    means: try fallback encodings and repair encoding problems in the text
  - name: normalize_whitespace
    type: bool
    default: 'False'
    required: false
    means: replace every run of whitespace in text by one space
  - name: allow_fragments
    type: bool
    default: 'True'
    required: false
    means: allow XML fragments without one root (accepted; these lines never read it)
  - name: repair_attributes
    type: bool
    default: 'True'
    required: false
    means: repair malformed attributes instead of parsing them plainly
  gives:
    type: Iterator[XMLEvent]
    means: 'a generator of events: StartElement, EndElement, Text, Comment, ProcessingInstruction, ParseError (EntityRef
      is never produced by these lines)'
  exported: true
  span:
    file: sloppy_xml.py
    lines: 517-1115
  provenance:
    mode: derived
    sources:
    - sloppy_xml.py#L517-L1115
    - sloppy_xml.py#L517-L581
    confidence: 1
    state: known
  made:
    move: survey
    run: 2026-11-05-2236-90fc
    step: 5
    node: '6'
    engine: code
  raises:
  - error: UnicodeDecodeError
    message: Unable to decode input with {options.encoding} encoding
    when: bytes read from xml_input cannot be decoded with encoding (and, when fix_encoding is on, with none of
      latin1, cp1252, ascii)
  ruling:
  - is: alike
    allowing: own-types
    because: 'the target''s own types: an iterator of one event type, a trait for tree builders'
    made-for: N:target/rust
    by: R:maker/transconceiver
    'on': '2026-11-18'
    said: 'sitting 1, Q1: as proposed: the driver contract is the kept interface, ruled changed for Rust (it ships
      sloppy-cases); the Python API alike, made-for rust; sitting 2: a fifth allowance, own-types, on the closed
