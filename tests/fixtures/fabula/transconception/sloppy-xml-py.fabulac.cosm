- id: C:interface/sloppy_xml.tree_parse
  type: interface
  name: tree_parse
  summary: Build XML tree from input or parsing events.
  stance: observed
  surface: function
  signature: 'def tree_parse(xml_input: Union[str, TextIO, Iterator[XMLEvent]], tree_builder: Optional[TreeBuilder]
    = None, tree: TreeType = "etree", **parse_options) -> ET.Element'
  defined-in: C:file/sloppy-xml-py
  takes:
  - name: xml_input
    type: Union[str, TextIO, Iterator[XMLEvent]]
    required: true
    means: an XML string, a file-like object, or an iterator of events
  - name: tree_builder
    type: Optional[TreeBuilder]
    default: None
    required: false
    means: the builder to feed; by default a new builder of the backend tree names
  - name: tree
    type: TreeType
    default: '"etree"'
    required: false
    means: 'the backend: "etree" for xml.etree.ElementTree, "lxml" for lxml (only when lxml is installed)'
  - name: '**parse_options'
    required: false
    means: keyword options passed to stream_parse when the input is parsed; allow_fragments is also read here
  gives:
