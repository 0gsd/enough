  stance: observed
  of:
  - C:interface/sloppy_xml.stream_parse
  when: an end tag does not match the innermost open tag and recover is on
  does: 'It searches the stack from the top for the end tag''s name. If found, every tag above it is popped and
    gets EndElement(name, line, column, auto_closed=True), innermost first, and the found tag itself is popped (its
    own EndElement, auto_closed False, comes from the parser). If not found, nothing is popped and no event is made:
    the stray end tag is still reported by the parser as an EndElement.'
  edges:
  - given: <a><b></a>
    then: StartElement a, StartElement b, EndElement b (auto_closed True), EndElement a (auto_closed False)
  - given: <a></b></a>
    then: StartElement a, EndElement b (auto_closed False, nothing closed), EndElement a
  span:
    file: sloppy_xml.py
    lines: 1359-1391
  provenance:
    mode: derived
    sources:
    - sloppy_xml.py#L1359-L1391
    confidence: 0.9
