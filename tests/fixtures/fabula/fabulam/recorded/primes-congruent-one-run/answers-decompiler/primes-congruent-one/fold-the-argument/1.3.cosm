engine: model:blind-decompiler
output: |
  yield:
    name: What the proof delivers
    beyond: "yes"
    says: 'For each k other than 0 and each bound n the proof names one prime congruent to 1 modulo k above n. For k = 1 it is any prime at least n + 1. For k > 1 it is the least prime factor of the absolute value of the k-th cyclotomic polynomial at b = k times n factorial, and the argument uses only that p is a prime dividing that value, so every prime factor of that value is above n and congruent to 1 modulo k. The least one is at most the value itself. The statement keeps only that the set of such primes is infinite.'
    as-statement: 'For every natural number k > 1 and every natural number n, every prime factor p of the absolute value of the k-th cyclotomic polynomial over the integers at k times n factorial satisfies n < p and p congruent to 1 modulo k; in particular there is such a prime p with n < p, and p at most that absolute value.'
    needs:
      - 'Replace the least prime factor by an arbitrary prime factor; the steps at lines 43-59 use only that p is prime and divides the value.'
      - 'Add that the least prime factor of a number greater than 1 is at most that number, for the upper end.'
    bound: between
    chooses:
      - {what: 'the point b at which the cyclotomic polynomial is evaluated', where: "Nat.exists_prime_gt_modEq_one", value: 'k times n factorial', gives: 'with b = k times m for any m at least 1 divisible by every number from 1 to n, each prime factor of the value is above n and congruent to 1 modulo k; the factor k keeps k nonzero modulo p, the factor m keeps p above n', best: 'k times the least common multiple of 1 to n, which gives a smaller value and so a smaller upper end; the file takes n factorial', confidence: medium}
      - {what: 'which prime factor of the value to take', where: "Nat.exists_prime_gt_modEq_one", value: 'the least prime factor', gives: 'any prime factor gives a prime above n congruent to 1 modulo k', best: "the file's choice, since the least factor gives the smallest witness", confidence: high}
      - {what: 'the prime in the case k = 1', where: "Nat.exists_prime_gt_modEq_one", value: 'a prime at least n + 1 from the infinitude of primes', gives: 'a prime above n, trivially congruent to 1 modulo 1', best: "the file's choice", confidence: high}
      - {what: 'the bound handed to the existence lemma', where: "Nat.frequently_atTop_modEq_one", value: 'each n in turn', gives: 'a prime p at least n with the property, the strict n < p weakened to n at most p', best: "the file's choice", confidence: high}
    trivial:
      - {case: 'k = 1', known: 'there are infinitely many primes, and every number is congruent to 1 modulo 1', delivered: 'any prime at least n + 1, for each n', compares: equal}
      - {case: 'k = 2', known: 'there are infinitely many odd primes', delivered: 'the prime factors of 2 times n factorial plus 1, each odd and above n', compares: equal}
      - {case: 'k = 4', known: 'prime factors of x squared plus 1 for even x are congruent to 1 modulo 4, so there are infinitely many such primes', delivered: 'the prime factors of 16 times n factorial squared plus 1, each above n and congruent to 1 modulo 4', compares: equal}
    grounds:
      - {of: "Nat.exists_prime_gt_modEq_one", lines: "28-59"}
      - {of: "Nat.frequently_atTop_modEq_one", lines: "61-65"}
      - {of: "Nat.infinite_setOfPred_prime_modEq_one", lines: "68-70"}
    confidence: high
  case: {slug: three-and-two, name: 'k = 3, n = 2', given: 'b = 3 times 2 factorial = 6, and the third cyclotomic polynomial is x squared plus x plus 1, so its value at 6 is 43.', expect: '43 is prime, so p = 43; 43 > 2, and 43 - 1 = 42 = 3 times 14, so 43 is congruent to 1 modulo 3; 6 cubed = 216 = 5 times 43 plus 1, so 6 has order exactly 3 modulo 43.'}
  constants:
    - {slug: factor-k, name: 'the factor k in b', says: 'b is a multiple of k', value: 'k', where: "Nat.exists_prime_gt_modEq_one", why: 'p does not divide b, so p does not divide k, so k is nonzero modulo p and a root of the k-th cyclotomic polynomial is a primitive k-th root of unity (lines 55-57)'}
    - {slug: factor-n-factorial, name: 'the factor n factorial in b', says: 'every number from 1 to n divides b', value: 'n factorial', where: "Nat.exists_prime_gt_modEq_one", why: 'a prime at most n would divide b, which p does not, so p > n (lines 51-52)'}
    - {slug: b-at-least-two, name: 'the lower bound on b', says: 'b is at least 2', value: '2', where: "Nat.exists_prime_gt_modEq_one", why: 'makes b - 1 at least 1 and b other than 1, so the value of the cyclotomic polynomial exceeds 1 and has a prime factor (lines 36-40)'}
    - {slug: k-one-start, name: 'the start of the search for k = 1', says: 'the prime is at least n + 1', value: 'n + 1', where: "Nat.exists_prime_gt_modEq_one", why: 'gives a prime strictly above n (line 31)'}
  slack:
    - {on: "Nat.exists_prime_gt_modEq_one", hypothesis: 'p is the least prime factor of the value', would-suffice: 'p is any prime dividing the value', lines: "41-48", confidence: high}
