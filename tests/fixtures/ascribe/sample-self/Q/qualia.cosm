  - id: Q:quale/quiet-at-night
    type: quale
    name: Quiet on the water at night
    summary: The hiss of the hull and nothing else, with the sky very close.
    form: F:form/celestial-navigation
    links:
      - {rel: from, to: E:experience/first-night-crossing}
    provenance: {mode: dialectic, sources: [session-2], confidence: 0.9}
