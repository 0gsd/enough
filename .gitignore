# macOS
.DS_Store

# enough runtime state
.llama-server/

# Per-install user config (seeded from defaults/ui-config.json on first run).
config/

# Claude Code local settings
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
# …but the built UI icons are a shipped asset, not a build artifact:
# scripts/build_icons.py generates them from the Illustrator sources and
# they must travel with the repo (the frontend loads /static/icons/build/).
!enough/static/icons/build/
!enough/static/icons/build/**
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtualenv
.venv/
venv/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Project artifacts
# (these appear inside user projects that `enough` bootstraps;
#  ignored defensively in case someone runs enough inside the repo itself)
rness/knowledge/session-logs/
dev/

